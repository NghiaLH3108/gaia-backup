@page
@model GaiaWeb.Pages.Admin.Batches.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lô nguyên liệu";
    ViewData["PageTitle"] = "Lô Nguyên Liệu";
    ViewData["ActivePage"] = "Batches";

    string StatusBadge(string status) => status switch {
        "Pending"       => "bg-amber-100 text-amber-700",
        "Approved"      => "bg-green-100 text-green-700",
        "Rejected"      => "bg-red-100 text-red-700",
        "Transporting"  => "bg-blue-100 text-blue-700",
        "ArrivedFactory"=> "bg-purple-100 text-purple-700",
        _               => "bg-gray-100 text-gray-500"
    };
    string StatusLabel(string status) => status switch {
        "Pending"       => "Chờ duyệt",
        "Approved"      => "Đã duyệt",
        "Rejected"      => "Từ chối",
        "Transporting"  => "Đang vận chuyển",
        "ArrivedFactory"=> "Đến xưởng",
        _               => status
    };
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Lô nguyên liệu</h1>
        <p class="text-on-surface-variant text-sm mt-1">Phê duyệt hoặc từ chối lô hàng từ nhà cung cấp</p>
    </div>
    <div class="flex gap-2">
        <a href="/Admin/Batches/Index" class="px-4 py-2 rounded-xl text-sm font-medium @(Model.Filter == "All" ? "bg-primary text-white" : "border border-outline-variant text-on-surface-variant hover:bg-surface-container-low")">
            Tất cả
        </a>
        <a href="/Admin/Batches/Index?filter=Pending" class="px-4 py-2 rounded-xl text-sm font-medium @(Model.Filter == "Pending" ? "bg-tertiary text-white" : "border border-outline-variant text-on-surface-variant hover:bg-surface-container-low")">
            Chờ duyệt
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium @(Model.IsSuccess ? "bg-green-50 text-green-700 border border-green-200" : "bg-red-50 text-red-700 border border-red-200")">
        @Model.Message
    </div>
}

<div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant/30">
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Mã lô</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Nhà cung cấp</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Trọng lượng</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Ngày gửi</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Trạng thái</th>
                <th class="px-6 py-4 text-right font-semibold text-on-surface-variant">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/10">
            @foreach (var b in Model.Batches)
            {
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="font-semibold text-on-surface">@b.BatchCode</div>
                        <div class="text-xs text-on-surface-variant mt-0.5">@b.CollectionAddress</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-on-surface">@(b.Supplier?.WarehouseName ?? "—")</div>
                        <div class="text-xs text-on-surface-variant">@(b.Supplier?.User?.FullName ?? "")</div>
                    </td>
                    <td class="px-6 py-4 text-on-surface">@b.WeightKg kg</td>
                    <td class="px-6 py-4 text-on-surface-variant text-xs">@b.CollectionTime.ToString("dd/MM/yyyy")</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold @StatusBadge(b.Status)">
                            @StatusLabel(b.Status)
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex justify-end gap-2">
                            @if (b.Status == "Pending")
                            {
                                <form method="post" asp-page-handler="Approve" asp-route-batchId="@b.BatchId" asp-route-filter="@Model.Filter">
                                    <button type="submit" class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-green-50 text-green-700 hover:bg-green-100 text-xs font-semibold transition-colors border border-green-200">
                                        <span class="material-symbols-outlined text-sm">check_circle</span> Duyệt
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Reject" asp-route-batchId="@b.BatchId" asp-route-filter="@Model.Filter"
                                      onsubmit="return confirm('Từ chối lô @b.BatchCode?')">
                                    <button type="submit" class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 text-xs font-semibold transition-colors border border-red-200">
                                        <span class="material-symbols-outlined text-sm">cancel</span> Từ chối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-on-surface-variant italic">Đã xử lý</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Batches.Any())
            {
                <tr>
                    <td colspan="6" class="px-6 py-16 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-5xl block mb-2 opacity-30">inventory_2</span>
                        <p>Không có lô hàng nào.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
