@page
@model GaiaWeb.Pages.Admin.Products.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Sản phẩm";
    ViewData["PageTitle"] = "Thêm Sản Phẩm";
    ViewData["ActivePage"] = "Products";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Admin/Products/Index" class="text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
    </a>
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Thêm Sản phẩm</h1>
        <p class="text-on-surface-variant text-sm">QR Token sẽ được tự động sinh khi tạo</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200">
        @Model.ErrorMessage
    </div>
}

<form method="post" class="max-w-2xl">
    <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6 space-y-5">
        <div>
            <label class="block text-sm font-medium text-on-surface-variant mb-1">Tên sản phẩm <span class="text-red-500">*</span></label>
            <input asp-for="ProductName" type="text" required placeholder="VD: Chậu GAIA Mini"
                   class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
        </div>
        <div>
            <label class="block text-sm font-medium text-on-surface-variant mb-1">Mô tả</label>
            <textarea asp-for="Description" rows="3" placeholder="Mô tả ngắn về sản phẩm..."
                      class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none"></textarea>
        </div>
        <div>
            <label class="block text-sm font-medium text-on-surface-variant mb-1">Lô nguyên liệu <span class="text-red-500">*</span></label>
            <select asp-for="BatchId" asp-items="Model.BatchOptions" required
                    class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
                <option value="">— Chọn lô nguyên liệu —</option>
            </select>
            <p class="text-xs text-on-surface-variant mt-1">Chỉ hiển thị các lô đã được Approved hoặc đã đến xưởng.</p>
        </div>
        <div>
            <label class="block text-sm font-medium text-on-surface-variant mb-1">Trạng thái</label>
            <select asp-for="CurrentStatus"
                    class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
                <option value="Available">Available — Sẵn sàng</option>
                <option value="Reserved">Reserved — Đã đặt trước</option>
                <option value="Sold">Sold — Đã bán</option>
            </select>
        </div>
    </div>

    <div class="flex justify-end gap-3 mt-6">
        <a href="/Admin/Products/Index" class="px-6 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant text-sm font-medium hover:bg-surface-container-low transition-colors">Hủy</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:opacity-90 transition-opacity shadow-sm">
            Tạo sản phẩm
        </button>
    </div>
</form>
