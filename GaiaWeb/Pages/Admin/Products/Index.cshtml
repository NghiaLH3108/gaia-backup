@page
@model GaiaWeb.Pages.Admin.Products.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sản phẩm";
    ViewData["PageTitle"] = "Quản Lý Sản Phẩm";
    ViewData["ActivePage"] = "Products";

    string StatusBadge(string s) => s switch {
        "Reserved"  => "bg-amber-100 text-amber-700",
        "Available" => "bg-green-100 text-green-700",
        "Sold"      => "bg-gray-100 text-gray-500",
        _           => "bg-gray-100 text-gray-500"
    };
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Sản phẩm</h1>
        <p class="text-on-surface-variant text-sm mt-1">Quản lý danh sách sản phẩm trong hệ thống</p>
    </div>
    <a href="/Admin/Products/Create" class="flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity shadow-sm">
        <span class="material-symbols-outlined text-base">add</span> Thêm sản phẩm
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium @(Model.IsSuccess ? "bg-green-50 text-green-700 border border-green-200" : "bg-red-50 text-red-700 border border-red-200")">
        @Model.Message
    </div>
}

<div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant/30">
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Sản phẩm</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Lô nguyên liệu</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">QR Token</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Trạng thái</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Ngày tạo</th>
                <th class="px-6 py-4 text-right font-semibold text-on-surface-variant">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/10">
            @foreach (var p in Model.Products)
            {
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="font-semibold text-on-surface">@p.ProductName</div>
                        <div class="text-xs text-on-surface-variant max-w-[180px] truncate mt-0.5">@p.Description</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-on-surface">@(p.Batch?.BatchCode ?? "—")</div>
                        <div class="text-xs text-on-surface-variant">@(p.Batch?.Supplier?.WarehouseName ?? "")</div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="font-mono text-xs text-on-surface-variant bg-surface-container-low px-2 py-1 rounded">
                            @p.Qrtoken.ToString().Substring(0, 8)...
                        </span>
                    </td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold @StatusBadge(p.CurrentStatus)">
                            @p.CurrentStatus
                        </span>
                    </td>
                    <td class="px-6 py-4 text-on-surface-variant text-xs">@p.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td class="px-6 py-4">
                        <div class="flex justify-end gap-2">
                            <a href="/Admin/Products/UploadVideo?productId=@p.ProductId"
                               class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-green-300 hover:text-green-600 text-xs font-medium transition-colors">
                                <span class="material-symbols-outlined text-sm">video_library</span> Video
                            </a>
                            <a href="/Admin/Products/Edit?productId=@p.ProductId"
                               class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-blue-300 hover:text-blue-600 text-xs font-medium transition-colors">
                                <span class="material-symbols-outlined text-sm">edit</span> Sửa
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-productId="@p.ProductId"
                                  onsubmit="return confirm('Xóa sản phẩm @p.ProductName? Hành động này không thể hoàn tác.')">
                                <button type="submit" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-red-300 hover:text-red-600 text-xs font-medium transition-colors">
                                    <span class="material-symbols-outlined text-sm">delete</span> Xóa
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Products.Any())
            {
                <tr>
                    <td colspan="6" class="px-6 py-16 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-5xl block mb-2 opacity-30">category</span>
                        <p>Chưa có sản phẩm nào.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
