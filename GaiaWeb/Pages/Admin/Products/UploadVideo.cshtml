@page
@model GaiaWeb.Pages.Admin.Products.UploadVideoModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tải lên Video";
    ViewData["PageTitle"] = "Tải Lên Video Sản Xuất";
    ViewData["ActivePage"] = "Products";
}

@section Head {
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
}

<!-- Hero Section -->
<header class="mb-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary mb-1">Tải lên Video Sản xuất Thủ công</h1>
            <p class="text-on-surface-variant text-sm max-w-2xl">
                Chia sẻ hành trình sáng tạo của sản phẩm. Video chân thực giúp khách hàng hiểu rõ giá trị bền vững trong từng sản phẩm.
            </p>
        </div>
        <a href="/Admin/Products/Index" class="inline-flex items-center gap-2 border border-outline-variant text-on-surface-variant hover:bg-surface-container-low px-4 py-2 rounded-lg font-label-md text-label-md transition-all">
            <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại
        </a>
    </div>
</header>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-6 p-4 rounded-xl text-sm font-medium border @(Model.IsSuccess ? "bg-green-50 text-green-700 border-green-200" : "bg-red-50 text-red-700 border-red-200")">
        @Model.Message
    </div>
}

<!-- Content Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Left Column: Upload Zone -->
    <div class="lg:col-span-6 space-y-6">
        
        <!-- Product Selector -->
        <section class="glass-card p-6 rounded-xl shadow-sm space-y-4">
            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Chọn sản phẩm cần cập nhật video</label>
                <select id="product-select" asp-for="ProductId" asp-items="Model.ProductOptions" 
                        class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 text-sm transition-all">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
            </div>
        </section>

        <!-- Video Drop Zone -->
        <section class="glass-card p-8 rounded-xl shadow-sm text-center border-dashed border-2 border-outline-variant hover:border-primary transition-colors cursor-pointer group relative overflow-hidden" id="drop-zone">
            <div class="py-4">
                <span class="material-symbols-outlined text-6xl text-primary mb-4 block group-hover:scale-110 transition-transform">cloud_upload</span>
                <h3 class="font-headline-md text-headline-md text-on-surface mb-2" id="upload-status-text">Kéo và thả video vào đây</h3>
                <p class="text-on-surface-variant text-sm mb-6" id="upload-sub-text">Hỗ trợ MP4, MOV, AVI lên đến 500MB</p>
                <button type="button" class="bg-primary text-white px-6 py-2.5 rounded-lg font-semibold text-sm hover:opacity-90 active:scale-95 transition-all shadow-md">Chọn tệp từ máy tính</button>
            </div>
            <div id="file-info" class="hidden absolute inset-0 bg-white/95 backdrop-blur-sm flex flex-col items-center justify-center p-6">
                <span class="material-symbols-outlined text-5xl text-primary mb-2">movie</span>
                <h4 class="font-semibold text-on-surface truncate max-w-[80%] text-sm" id="selected-file-name">filename.mp4</h4>
                <p class="text-xs text-on-surface-variant mb-4" id="selected-file-size">0 MB</p>
                <button type="button" id="remove-file-btn" class="text-error text-sm font-semibold flex items-center gap-1">
                    <span class="material-symbols-outlined text-sm">delete</span> Thay đổi tệp
                </button>
            </div>
        </section>

        <!-- Current Video Player -->
        <section id="current-video-area" class="glass-card p-6 rounded-xl shadow-sm hidden">
            <h4 class="font-semibold text-on-surface text-sm mb-3 flex items-center gap-1">
                <span class="material-symbols-outlined text-primary">play_circle</span> Video hiện tại của bước này
            </h4>
            <div class="aspect-video rounded-lg overflow-hidden border border-outline-variant bg-black">
                <video id="current-video-player" class="w-full h-full object-contain" controls>
                    <source id="current-video-source" src="" type="video/mp4"/>
                    Trình duyệt không hỗ trợ phát video.
                </video>
            </div>
            <div class="mt-3 flex justify-between items-center text-xs">
                <span class="text-on-surface-variant truncate max-w-[80%]" id="current-video-path"></span>
                <a id="current-video-link" href="#" target="_blank" class="text-primary font-bold hover:underline">Mở tab mới</a>
            </div>
        </section>
    </div>

    <!-- Right Column: Form Fields -->
    <div class="lg:col-span-6">
        <form method="post" enctype="multipart/form-data" class="glass-card p-6 rounded-xl shadow-sm space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId"/>
            <input type="file" id="video-input" asp-for="VideoFile" accept="video/*" class="hidden"/>

            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Công đoạn sản xuất</label>
                <select id="timeline-select" asp-for="SelectedTimelineId" 
                        class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 text-sm transition-all">
                    <option value="0">-- Chọn công đoạn --</option>
                    @foreach (var t in Model.Timelines)
                    {
                        <option value="@t.TimelineId">Bước @t.StepOrder: @t.Title</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Tiêu đề Video / Bước</label>
                <input id="video-title" type="text" asp-for="VideoTitle" 
                       class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 text-sm transition-all"
                       placeholder="Ví dụ: Sơ chế nguyên liệu và phơi khô bột vỏ sầu riêng"/>
            </div>

            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Nghệ nhân thực hiện</label>
                <input id="artisan-name" type="text" asp-for="ArtisanName" 
                       class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 text-sm transition-all"
                       placeholder="Tên nghệ nhân"/>
            </div>

            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Mô tả quy trình chi tiết</label>
                <textarea id="video-description" asp-for="ProcessDescription" 
                          class="w-full bg-surface-container-low border border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary rounded-lg py-2.5 px-4 text-sm transition-all resize-none"
                          placeholder="Mô tả chi tiết các bước thực hiện..." rows="4"></textarea>
            </div>

            <div>
                <label class="block font-semibold text-on-surface text-sm mb-2">Chỉ số Bền vững (Gợi ý)</label>
                <div class="flex flex-wrap gap-2">
                    <span class="bg-primary/10 text-primary px-3 py-1 rounded-full text-xs font-bold border border-primary/20">#CircularEconomy</span>
                    <span class="bg-secondary/10 text-secondary px-3 py-1 rounded-full text-xs font-bold border border-secondary/20">#Handmade</span>
                    <span class="bg-tertiary/10 text-tertiary px-3 py-1 rounded-full text-xs font-bold border border-tertiary/20">#EcoFriendly</span>
                </div>
            </div>

            <div class="pt-2 flex items-center gap-4">
                <a href="/Admin/Products/Index" class="flex-1 text-center font-semibold text-sm text-on-surface-variant border border-outline-variant hover:bg-surface-container-low py-2.5 rounded-lg transition-all">Hủy bỏ</a>
                <button class="flex-[2] font-semibold text-sm bg-primary text-white py-2.5 rounded-lg shadow-md hover:opacity-90 active:scale-95 transition-all flex items-center justify-center gap-2" type="submit">
                    <span class="material-symbols-outlined">publish</span> Tải lên video
                </button>
            </div>
        </form>

        <!-- Tip area -->
        <div class="mt-4 p-4 bg-primary/5 border border-primary/20 rounded-xl flex gap-3">
            <span class="material-symbols-outlined text-primary shrink-0">lightbulb</span>
            <p class="text-xs text-on-surface-variant leading-relaxed">
                <strong>Mẹo:</strong> Video ngắn 30-60 giây, tập trung cận cảnh vào quá trình chế tác thủ công giúp khách hàng cảm nhận giá trị sản phẩm GAIA sâu sắc hơn.
            </p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const timelines = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Timelines.Select(t => new { 
        t.TimelineId, t.Title, t.Description, t.VideoUrl 
    })));

    document.addEventListener('DOMContentLoaded', () => {
        const dropZone = document.getElementById('drop-zone');
        const videoInput = document.getElementById('video-input');
        const fileInfo = document.getElementById('file-info');
        const selectedFileName = document.getElementById('selected-file-name');
        const selectedFileSize = document.getElementById('selected-file-size');
        const removeFileBtn = document.getElementById('remove-file-btn');
        const productSelect = document.getElementById('product-select');
        const timelineSelect = document.getElementById('timeline-select');
        const videoTitleInput = document.getElementById('video-title');
        const artisanNameInput = document.getElementById('artisan-name');
        const videoDescInput = document.getElementById('video-description');
        const currentVideoArea = document.getElementById('current-video-area');
        const currentVideoPlayer = document.getElementById('current-video-player');
        const currentVideoSource = document.getElementById('current-video-source');
        const currentVideoLink = document.getElementById('current-video-link');
        const currentVideoPath = document.getElementById('current-video-path');

        productSelect.addEventListener('change', function() {
            if (this.value) window.location.href = `/Admin/Products/UploadVideo?productId=${this.value}`;
        });

        timelineSelect.addEventListener('change', function() {
            const selectedId = parseInt(this.value);
            const step = timelines.find(t => t.TimelineId === selectedId);
            if (step) {
                videoTitleInput.value = step.Title || '';
                let rawDesc = step.Description || '';
                let artisan = '', cleanDesc = rawDesc;
                const artisanPrefix = "Nghệ nhân: ";
                if (rawDesc.startsWith(artisanPrefix)) {
                    const newlineIndex = rawDesc.indexOf('\n');
                    if (newlineIndex !== -1) {
                        artisan = rawDesc.substring(artisanPrefix.length, newlineIndex).trim();
                        cleanDesc = rawDesc.substring(newlineIndex + 1);
                    } else {
                        artisan = rawDesc.substring(artisanPrefix.length).trim();
                        cleanDesc = '';
                    }
                }
                artisanNameInput.value = artisan;
                videoDescInput.value = cleanDesc;
                if (step.VideoUrl && !step.VideoUrl.startsWith('/videos/process_')) {
                    currentVideoSource.src = step.VideoUrl;
                    currentVideoPlayer.load();
                    currentVideoPath.innerText = step.VideoUrl;
                    currentVideoLink.href = step.VideoUrl;
                    currentVideoArea.classList.remove('hidden');
                } else {
                    currentVideoArea.classList.add('hidden');
                    currentVideoPlayer.pause();
                }
            } else {
                videoTitleInput.value = ''; artisanNameInput.value = ''; videoDescInput.value = '';
                currentVideoArea.classList.add('hidden'); currentVideoPlayer.pause();
            }
        });

        if (timelineSelect.value && timelineSelect.value !== "0") {
            timelineSelect.dispatchEvent(new Event('change'));
        } else if (timelineSelect.options.length > 1) {
            timelineSelect.selectedIndex = 1;
            timelineSelect.dispatchEvent(new Event('change'));
        }

        dropZone.addEventListener('click', () => videoInput.click());
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-primary', 'bg-primary/5'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-primary', 'bg-primary/5'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault(); dropZone.classList.remove('border-primary', 'bg-primary/5');
            if (e.dataTransfer.files.length > 0) { videoInput.files = e.dataTransfer.files; displayFileInfo(e.dataTransfer.files[0]); }
        });
        videoInput.addEventListener('change', () => { if (videoInput.files.length > 0) displayFileInfo(videoInput.files[0]); });
        removeFileBtn.addEventListener('click', (e) => { e.stopPropagation(); videoInput.value = ''; fileInfo.classList.add('hidden'); });

        function displayFileInfo(file) {
            selectedFileName.innerText = file.name;
            selectedFileSize.innerText = (file.size / (1024 * 1024)).toFixed(2) + " MB";
            fileInfo.classList.remove('hidden');
        }
    });
</script>
}
