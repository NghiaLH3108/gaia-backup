@page
@model GaiaWeb.Pages.Admin.Suppliers.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa Nhà cung cấp";
    ViewData["PageTitle"] = "Sửa Nhà Cung Cấp";
    ViewData["ActivePage"] = "Suppliers";
}

<div class="flex items-center gap-3 mb-6">
    <a href="/Admin/Suppliers/Index" class="text-on-surface-variant hover:text-on-surface transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
    </a>
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Sửa Nhà cung cấp</h1>
        <p class="text-on-surface-variant text-sm">Cập nhật thông tin kho và tài khoản</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200">
        @Model.ErrorMessage
    </div>
}

<form method="post" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <input type="hidden" asp-for="SupplierId" />

    <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6">
        <h2 class="font-semibold text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">warehouse</span> Thông tin kho
        </h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">Tên kho <span class="text-red-500">*</span></label>
                <input asp-for="WarehouseName" type="text" required
                       class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">Địa chỉ kho</label>
                <input asp-for="Address" type="text"
                       class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">Vĩ độ</label>
                    <input asp-for="Latitude" type="number" step="0.000001"
                           class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
                </div>
                <div>
                    <label class="block text-sm font-medium text-on-surface-variant mb-1">Kinh độ</label>
                    <input asp-for="Longitude" type="number" step="0.000001"
                           class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6">
        <h2 class="font-semibold text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">person</span> Thông tin liên hệ
        </h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">Họ và tên</label>
                <input asp-for="FullName" type="text"
                       class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
            </div>
            <div>
                <label class="block text-sm font-medium text-on-surface-variant mb-1">Số điện thoại</label>
                <input asp-for="Phone" type="tel"
                       class="w-full border border-outline-variant rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors">
            </div>
            <div class="p-3 bg-surface-container-low rounded-xl text-xs text-on-surface-variant flex items-center gap-2">
                <span class="material-symbols-outlined text-sm">info</span>
                Email và mật khẩu không thể thay đổi ở đây.
            </div>
        </div>
    </div>

    <div class="lg:col-span-2 flex justify-end gap-3">
        <a href="/Admin/Suppliers/Index" class="px-6 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant text-sm font-medium hover:bg-surface-container-low transition-colors">Hủy</a>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-white text-sm font-semibold hover:opacity-90 transition-opacity shadow-sm">
            Lưu thay đổi
        </button>
    </div>
</form>
