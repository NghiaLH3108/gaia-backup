@page
@model GaiaWeb.Pages.Admin.Suppliers.EditModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Sửa Nhà cung cấp | GAIA Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
<div class="flex min-h-screen">
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col shadow-sm fixed h-full z-30">
        <div class="p-6 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-700 rounded-xl flex items-center justify-center shadow-lg">
                    <span class="material-symbols-outlined text-white text-2xl">shield</span>
                </div>
                <div>
                    <div class="font-bold text-green-700 text-lg leading-tight">GAIA Admin</div>
                    <div class="text-xs text-gray-400">Quản trị hệ thống</div>
                </div>
            </div>
        </div>
        <nav class="flex-1 p-4 space-y-1">
            <a href="/Admin/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm">
                <span class="material-symbols-outlined text-xl">dashboard</span> Dashboard
            </a>
            <a href="/Admin/Suppliers/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 text-green-700 font-semibold text-sm">
                <span class="material-symbols-outlined text-xl">group</span> Nhà cung cấp
            </a>
            <a href="/Admin/Batches/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm">
                <span class="material-symbols-outlined text-xl">inventory_2</span> Lô nguyên liệu
            </a>
            <a href="/Admin/Products/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm">
                <span class="material-symbols-outlined text-xl">category</span> Sản phẩm
            </a>
        </nav>
        <div class="p-4 border-t border-gray-100">
            <a href="/Logout" class="flex items-center gap-2 px-4 py-2 rounded-lg text-red-500 hover:bg-red-50 text-sm font-medium w-full">
                <span class="material-symbols-outlined text-base">logout</span> Đăng xuất
            </a>
        </div>
    </aside>

    <main class="flex-1 ml-64 p-8">
        <div class="flex items-center gap-3 mb-6">
            <a href="/Admin/Suppliers/Index" class="text-gray-400 hover:text-gray-600">
                <span class="material-symbols-outlined">arrow_back</span>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Sửa Nhà cung cấp</h1>
                <p class="text-gray-500 text-sm">Cập nhật thông tin kho và tài khoản</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium bg-red-50 text-red-700 border border-red-200">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <input type="hidden" asp-for="SupplierId" />

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h2 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-green-700">warehouse</span> Thông tin kho
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tên kho <span class="text-red-500">*</span></label>
                        <input asp-for="WarehouseName" type="text" required
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ kho</label>
                        <input asp-for="Address" type="text"
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Vĩ độ</label>
                            <input asp-for="Latitude" type="number" step="0.000001"
                                   class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Kinh độ</label>
                            <input asp-for="Longitude" type="number" step="0.000001"
                                   class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                <h2 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-green-700">person</span> Thông tin liên hệ
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Họ và tên</label>
                        <input asp-for="FullName" type="text"
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Số điện thoại</label>
                        <input asp-for="Phone" type="tel"
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-500">
                    </div>
                    <div class="p-3 bg-gray-50 rounded-xl text-xs text-gray-500">
                        <span class="material-symbols-outlined text-sm align-middle">info</span>
                        Email và mật khẩu không thể thay đổi ở đây.
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 flex justify-end gap-3">
                <a href="/Admin/Suppliers/Index" class="px-6 py-2.5 rounded-xl border border-gray-200 text-gray-600 text-sm font-medium hover:bg-gray-50">Hủy</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-green-700 text-white text-sm font-semibold hover:bg-green-800 transition-colors shadow-sm">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </main>
</div>
</body>
</html>
