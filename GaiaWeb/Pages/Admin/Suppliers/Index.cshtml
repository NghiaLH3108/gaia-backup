@page
@model GaiaWeb.Pages.Admin.Suppliers.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhà cung cấp";
    ViewData["PageTitle"] = "Quản Lý Nhà Cung Cấp";
    ViewData["ActivePage"] = "Suppliers";
}

<div class="flex justify-between items-center mb-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Nhà cung cấp</h1>
        <p class="text-on-surface-variant text-sm mt-1">Quản lý danh sách Supplier trong hệ thống</p>
    </div>
    <a href="/Admin/Suppliers/Create" class="flex items-center gap-2 bg-primary text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:opacity-90 transition-opacity shadow-sm">
        <span class="material-symbols-outlined text-base">add</span> Thêm Supplier
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-4 px-4 py-3 rounded-xl text-sm font-medium @(Model.IsSuccess ? "bg-green-50 text-green-700 border border-green-200" : "bg-red-50 text-red-700 border border-red-200")">
        @Model.Message
    </div>
}

<div class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="bg-surface-container-low border-b border-outline-variant/30">
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Nhà cung cấp</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Tài khoản</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Địa chỉ</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Số lô hàng</th>
                <th class="px-6 py-4 text-left font-semibold text-on-surface-variant">Trạng thái</th>
                <th class="px-6 py-4 text-right font-semibold text-on-surface-variant">Thao tác</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/10">
            @foreach (var s in Model.Suppliers)
            {
                var isActive = s.User?.Status == "Active";
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                    <td class="px-6 py-4">
                        <div class="font-semibold text-on-surface">@s.WarehouseName</div>
                        <div class="text-xs text-on-surface-variant mt-0.5">ID #@s.SupplierId</div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-on-surface">@(s.User?.FullName ?? "—")</div>
                        <div class="text-xs text-on-surface-variant">@(s.User?.Email ?? "—")</div>
                    </td>
                    <td class="px-6 py-4 text-on-surface-variant max-w-[180px] truncate">@s.Address</td>
                    <td class="px-6 py-4 text-on-surface">@s.MaterialBatches.Count lô</td>
                    <td class="px-6 py-4">
                        @if (isActive)
                        {
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">Hoạt động</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">Vô hiệu</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex justify-end gap-2">
                            <a href="/Admin/Suppliers/Edit?supplierId=@s.SupplierId"
                               class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-blue-300 hover:text-blue-600 text-xs font-medium transition-colors">
                                <span class="material-symbols-outlined text-sm">edit</span> Sửa
                            </a>
                            @if (isActive)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-supplierId="@s.SupplierId"
                                      onsubmit="return confirm('Vô hiệu hóa nhà cung cấp @s.WarehouseName?')">
                                    <button type="submit" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-red-300 hover:text-red-600 text-xs font-medium transition-colors">
                                        <span class="material-symbols-outlined text-sm">block</span> Vô hiệu
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Restore" asp-route-supplierId="@s.SupplierId"
                                      onsubmit="return confirm('Kích hoạt lại nhà cung cấp @s.WarehouseName?')">
                                    <button type="submit" class="flex items-center gap-1 px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface-variant hover:border-green-300 hover:text-green-600 text-xs font-medium transition-colors">
                                        <span class="material-symbols-outlined text-sm">check_circle</span> Kích hoạt
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Suppliers.Any())
            {
                <tr>
                    <td colspan="6" class="px-6 py-16 text-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-5xl block mb-2 opacity-30">group</span>
                        <p>Chưa có nhà cung cấp nào.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
