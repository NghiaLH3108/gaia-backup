@page
@model GaiaWeb.Pages.Admin.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Admin Dashboard | GAIA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
<!-- Sidebar -->
<div class="flex min-h-screen">
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col shadow-sm fixed h-full z-30">
        <div class="p-6 border-b border-gray-100">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-700 rounded-xl flex items-center justify-center shadow-lg">
                    <span class="material-symbols-outlined text-white text-2xl">shield</span>
                </div>
                <div>
                    <div class="font-bold text-green-700 text-lg leading-tight">GAIA Admin</div>
                    <div class="text-xs text-gray-400">Quản trị hệ thống</div>
                </div>
            </div>
        </div>
        <nav class="flex-1 p-4 space-y-1">
            <a href="/Admin/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-green-50 text-green-700 font-semibold text-sm">
                <span class="material-symbols-outlined text-xl">dashboard</span> Dashboard
            </a>
            <a href="/Admin/Suppliers/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm transition-colors">
                <span class="material-symbols-outlined text-xl">group</span> Nhà cung cấp
            </a>
            <a href="/Admin/Batches/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm transition-colors">
                <span class="material-symbols-outlined text-xl">inventory_2</span> Lô nguyên liệu
            </a>
            <a href="/Admin/Products/Index" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-gray-50 font-medium text-sm transition-colors">
                <span class="material-symbols-outlined text-xl">category</span> Sản phẩm
            </a>
        </nav>
        <div class="p-4 border-t border-gray-100">
            <div class="flex items-center gap-3 mb-3 px-2">
                <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-green-700 text-base">person</span>
                </div>
                <div>
                    <div class="text-sm font-semibold text-gray-800">@Model.UserName</div>
                    <div class="text-xs text-gray-400">Admin</div>
                </div>
            </div>
            <a href="/Logout" class="flex items-center gap-2 px-4 py-2 rounded-lg text-red-500 hover:bg-red-50 text-sm font-medium transition-colors w-full">
                <span class="material-symbols-outlined text-base">logout</span> Đăng xuất
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-8">
        <div class="mb-8">
            <h1 class="text-2xl font-bold text-gray-800">Dashboard</h1>
            <p class="text-gray-500 mt-1">Tổng quan hệ thống GAIA</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                <div class="w-14 h-14 bg-green-50 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-green-700 text-3xl">group</span>
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-800">@Model.TotalSuppliers</div>
                    <div class="text-sm text-gray-500">Nhà cung cấp</div>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                <div class="w-14 h-14 bg-amber-50 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-amber-600 text-3xl">pending_actions</span>
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-800">@Model.PendingBatches</div>
                    <div class="text-sm text-gray-500">Lô chờ duyệt</div>
                </div>
            </div>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center gap-4">
                <div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-blue-600 text-3xl">category</span>
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-800">@Model.TotalProducts</div>
                    <div class="text-sm text-gray-500">Sản phẩm</div>
                </div>
            </div>
        </div>

        <!-- Quick Links -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="/Admin/Suppliers/Index" class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-green-200 hover:shadow-md transition-all group">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center group-hover:bg-green-100 transition-colors">
                        <span class="material-symbols-outlined text-green-700 text-2xl">group</span>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800 mb-1">Quản lý Nhà cung cấp</h3>
                        <p class="text-sm text-gray-500">Thêm, sửa, vô hiệu hóa tài khoản Supplier</p>
                    </div>
                </div>
            </a>
            <a href="/Admin/Batches/Index" class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-amber-200 hover:shadow-md transition-all group">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center group-hover:bg-amber-100 transition-colors">
                        <span class="material-symbols-outlined text-amber-600 text-2xl">fact_check</span>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800 mb-1">Duyệt Lô nguyên liệu</h3>
                        <p class="text-sm text-gray-500">Phê duyệt hoặc từ chối lô hàng Pending</p>
                    </div>
                </div>
            </a>
            <a href="/Admin/Products/Index" class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-blue-200 hover:shadow-md transition-all group">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                        <span class="material-symbols-outlined text-blue-600 text-2xl">category</span>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-800 mb-1">Quản lý Sản phẩm</h3>
                        <p class="text-sm text-gray-500">Tạo, sửa, xóa sản phẩm trong hệ thống</p>
                    </div>
                </div>
            </a>
        </div>
    </main>
</div>
</body>
</html>
