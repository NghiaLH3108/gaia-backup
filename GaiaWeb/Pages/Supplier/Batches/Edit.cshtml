@page
@model GaiaWeb.Pages.Supplier.Batches.EditModel
@{
    Layout = "_SupplierLayout";
    ViewData["Title"] = "Chỉnh sửa lô hàng";
    ViewData["PageTitle"] = "Chỉnh Sửa Lô Hàng";
    ViewData["ActivePage"] = "Batches";

    string collTimeVal = Model.Input.CollectionTime == default
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        : Model.Input.CollectionTime.ToString("yyyy-MM-ddTHH:mm");
    bool isEditable = Model.Batch?.Status == "Pending";
}

@section Head {
    <style>
        .glass-card { background: rgba(255,255,255,0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.3); }
    </style>
}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

    <!-- Left column: Form -->
    <div class="lg:col-span-8 space-y-6">

        <!-- Warning banner if not Pending -->
        @if (!isEditable && Model.Batch != null)
        {
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 flex items-center gap-4">
                <span class="material-symbols-outlined text-warning-orange">warning</span>
                <p class="text-on-surface text-sm font-semibold">
                    Lô hàng này có trạng thái <strong>@Model.Batch.Status</strong> — không thể chỉnh sửa. Chỉ chỉnh sửa được khi trạng thái là <strong>Pending</strong>.
                </p>
            </div>
        }
        @if (isEditable)
        {
            <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 flex items-center gap-4">
                <span class="material-symbols-outlined text-warning-orange">info</span>
                <p class="text-on-surface text-sm font-semibold">
                    Thông tin chỉ có thể chỉnh sửa trước khi Quản trị viên phê duyệt.
                </p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-error-container border border-red-200 p-4 rounded-xl flex items-center gap-3">
                <span class="material-symbols-outlined text-error">error</span>
                <span class="text-on-error-container text-sm">@Model.ErrorMessage</span>
            </div>
        }

        <!-- Title -->
        <div>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">
                Chỉnh sửa Lô hàng <span class="text-primary">@(Model.Batch?.BatchCode ?? "")</span>
            </h2>
            <p class="text-on-surface-variant text-sm">Cập nhật chi tiết thông tin thu gom và nguyên liệu.</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-xl p-6 md:p-8 shadow-sm border border-outline-variant/30 space-y-8">

            <!-- Supplier info (read-only) -->
            <div class="space-y-4">
                <div class="flex items-center gap-2 border-l-4 border-primary pl-3">
                    <h3 class="font-bold text-on-surface">Thông tin Nhà cung cấp</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="text-xs font-semibold text-on-surface-variant mb-1 block">Tên Nhà cung cấp</label>
                        <input type="text" value="@Model.SupplierName" readonly class="w-full bg-surface-accent/10 border-none rounded-lg p-3 text-sm outline-none cursor-not-allowed text-on-surface-variant">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-on-surface-variant mb-1 block">Cơ sở / Kho</label>
                        <input type="text" value="@Model.WarehouseName" readonly class="w-full bg-surface-accent/10 border-none rounded-lg p-3 text-sm outline-none cursor-not-allowed text-on-surface-variant">
                    </div>
                </div>
            </div>

            <!-- Material details (editable) -->
            <div class="space-y-4">
                <div class="flex items-center gap-2 border-l-4 border-secondary pl-3">
                    <h3 class="font-bold text-on-surface">Chi tiết Nguyên liệu</h3>
                </div>
                <form method="post" action="/Supplier/Batches/Edit?batchId=@Model.BatchId" id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BatchId" value="@Model.BatchId">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="text-xs font-semibold text-on-surface-variant mb-1 block">Khối lượng (kg) <span class="text-error">*</span></label>
                            <input id="weightKg"
                                   name="Input.WeightKg"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   value="@(Model.Input.WeightKg > 0 ? Model.Input.WeightKg.ToString() : Model.Batch?.WeightKg.ToString() ?? "")"
                                   @(isEditable ? "" : "readonly")
                                   class="w-full @(isEditable ? "bg-surface-accent/20 border border-outline-variant focus:ring-2 focus:ring-secondary" : "bg-surface-accent/10 cursor-not-allowed border-none") rounded-lg p-3 text-sm outline-none">
                            <span asp-validation-for="Input.WeightKg" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div>
                            <label class="text-xs font-semibold text-on-surface-variant mb-1 block">Thời gian thu gom <span class="text-error">*</span></label>
                            <input id="collectionTime"
                                   name="Input.CollectionTime"
                                   type="datetime-local"
                                   value="@collTimeVal"
                                   @(isEditable ? "" : "readonly")
                                   class="w-full @(isEditable ? "bg-surface-accent/20 border border-outline-variant focus:ring-2 focus:ring-secondary" : "bg-surface-accent/10 cursor-not-allowed border-none") rounded-lg p-3 text-sm outline-none">
                            <span asp-validation-for="Input.CollectionTime" class="text-error text-xs mt-1 block"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label class="text-xs font-semibold text-on-surface-variant mb-1 block">Địa điểm thu gom <span class="text-error">*</span></label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">location_on</span>
                                <input id="collectionAddress"
                                       name="Input.CollectionAddress"
                                       type="text"
                                       value="@(string.IsNullOrEmpty(Model.Input.CollectionAddress) ? Model.Batch?.CollectionAddress : Model.Input.CollectionAddress)"
                                       @(isEditable ? "" : "readonly")
                                       class="w-full pl-10 @(isEditable ? "bg-surface-accent/20 border border-outline-variant focus:ring-2 focus:ring-secondary" : "bg-surface-accent/10 cursor-not-allowed border-none") rounded-lg p-3 text-sm outline-none">
                            </div>
                            <span asp-validation-for="Input.CollectionAddress" class="text-error text-xs mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Photos preview (read-only) -->
                    @if (Model.Batch != null && Model.Batch.MaterialImages.Any())
                    {
                        <div class="mt-6 space-y-3">
                            <div class="flex items-center justify-between border-l-4 border-tertiary-container pl-3">
                                <h3 class="font-bold text-on-surface">Hình ảnh đã upload</h3>
                            </div>
                            <div class="grid grid-cols-3 md:grid-cols-5 gap-3">
                                @foreach (var img in Model.Batch.MaterialImages)
                                {
                                    <div class="aspect-square rounded-xl overflow-hidden border border-outline-variant">
                                        <img src="@img.ImageUrl" alt="Ảnh nguyên liệu" class="w-full h-full object-cover">
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Actions -->
                    <div class="flex flex-col md:flex-row items-center justify-end gap-4 pt-6 border-t border-outline-variant/30 mt-6">
                        <a href="/Supplier/Batches" class="w-full md:w-auto px-8 py-2.5 border border-outline-variant text-on-surface-variant font-semibold rounded-lg hover:bg-surface-container-low transition-colors text-center text-sm">
                            Hủy bỏ
                        </a>
                        @if (isEditable)
                        {
                            <button type="submit" id="saveBtn"
                                    class="w-full md:w-auto px-10 py-2.5 bg-primary text-white font-semibold rounded-lg hover:opacity-90 shadow-md shadow-primary/20 transition-all flex items-center justify-center gap-2 text-sm">
                                Lưu thay đổi <span class="material-symbols-outlined text-[18px]">check_circle</span>
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right column: Sidebar -->
    <aside class="lg:col-span-4 space-y-6">

        <!-- Transportation History -->
        @if (Model.Batch != null && Model.Batch.TransportationHistories.Any())
        {
            <div class="bg-white rounded-xl p-6 border border-outline-variant/30 space-y-5">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">local_shipping</span>
                    <h3 class="font-bold text-on-surface">Lịch sử vận chuyển</h3>
                </div>
                <div class="space-y-5 relative">
                    <div class="absolute left-4 top-2 bottom-2 w-0.5 bg-outline-variant/50"></div>
                    @foreach (var hist in Model.Batch.TransportationHistories)
                    {
                        <div class="relative pl-10">
                            <div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full bg-secondary ring-4 ring-secondary/20"></div>
                            <div>
                                <p class="font-bold text-sm text-on-surface">@hist.Status</p>
                                <p class="text-xs text-on-surface-variant">@hist.UpdateTime.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="text-xs text-on-surface mt-1 italic">@hist.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Status card -->
        <div class="glass-card rounded-xl p-6 space-y-4">
            <h4 class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Trạng thái hiện tại</h4>
            @{
                var (statusColor, statusLabel) = (Model.Batch?.Status ?? "") switch {
                    "Pending"        => ("text-warning-orange", "Đang chờ phê duyệt"),
                    "Approved"       => ("text-primary", "Đã phê duyệt"),
                    "Rejected"       => ("text-error", "Đã từ chối"),
                    "Transporting"   => ("text-tertiary", "Đang vận chuyển"),
                    "ArrivedFactory" => ("text-secondary", "Đã đến nhà máy"),
                    _                => ("text-outline", "Không xác định")
                };
            }
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-current @statusColor animate-pulse"></div>
                <span class="font-bold text-lg @statusColor">@statusLabel</span>
            </div>
            <div class="p-4 bg-surface-accent/20 rounded-lg flex items-start gap-3">
                <span class="material-symbols-outlined text-primary text-sm shrink-0">info</span>
                <p class="text-xs text-on-surface-variant leading-relaxed">
                    @if (isEditable)
                    {
                        @:Bạn có thể cập nhật thông tin cho đến khi Admin phê duyệt hoặc từ chối.
                    }
                    else
                    {
                        @:Lô hàng này không còn ở trạng thái Pending, không thể chỉnh sửa.
                    }
                </p>
            </div>
        </div>

        <!-- Batch meta info -->
        @if (Model.Batch != null)
        {
            <div class="bg-white rounded-xl p-6 border border-outline-variant/30 space-y-3">
                <h4 class="text-xs font-bold text-on-surface-variant uppercase tracking-wider">Thông tin lô hàng</h4>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-on-surface-variant">Mã lô:</span>
                        <span class="font-bold text-primary font-mono">@Model.Batch.BatchCode</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-on-surface-variant">Ngày tạo:</span>
                        <span class="font-medium">@Model.Batch.CreatedDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-on-surface-variant">Số ảnh:</span>
                        <span class="font-medium">@Model.Batch.MaterialImages.Count ảnh</span>
                    </div>
                </div>
            </div>
        }
    </aside>

</div>

@section Scripts {
<script>
    const form = document.getElementById('editForm');
    const saveBtn = document.getElementById('saveBtn');
    if (form && saveBtn) {
        form.addEventListener('submit', () => {
            saveBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Đang lưu...';
            setTimeout(() => { saveBtn.disabled = true; }, 0);
        });
    }
</script>
}
