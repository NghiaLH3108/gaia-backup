@page
@model GaiaWeb.Pages.Supplier.Batches.TransportationModel
@{
    Layout = null;
    var histList = Model.Batch?.TransportationHistories
        .OrderByDescending(h => h.UpdateTime).ToList()
        ?? new List<GaiaWeb.DAL.Models.TransportationHistory>();

    // Progress: Pending=0, Approved=1, Transporting=2, ArrivedFactory=3
    int progress = (Model.Batch?.Status ?? "") switch {
        "Approved"       => 1,
        "Transporting"   => 2,
        "ArrivedFactory" => 3,
        _                => 0
    };
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cập nhật vận chuyển | GAIA</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet">
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "outline-variant": "#bfcaba", "glass-fill": "rgba(255,255,255,0.7)",
                        "secondary": "#006e1c", "background": "#fff8f6",
                        "on-primary": "#ffffff", "primary-container": "#2e7d32",
                        "surface-container-low": "#fff1ec", "on-secondary-container": "#00731e",
                        "tertiary": "#00598f", "error": "#ba1a1a", "surface-accent": "#C8E6C9",
                        "surface-light": "#FFFFFF", "on-primary-container": "#cbffc2",
                        "secondary-container": "#91f78e", "on-surface": "#2b160f",
                        "outline": "#707a6c", "primary": "#0d631b", "surface-variant": "#ffdbce",
                        "tertiary-container": "#0072b6", "on-secondary": "#ffffff",
                        "glass-stroke": "rgba(255,255,255,0.3)", "surface-container-lowest": "#ffffff",
                        "surface-container-high": "#ffe2d9", "surface-container": "#ffe9e2",
                        "warning-orange": "#FF9800", "surface": "#fff8f6",
                        "error-container": "#ffdad6", "on-surface-variant": "#40493d",
                        "on-error-container": "#93000a", "on-background": "#2b160f"
                    },
                    fontFamily: { "headline-md": ["Inter"], "headline-lg": ["Inter"], "body-md": ["Inter"], "label-sm": ["Inter"] },
                    fontSize: {
                        "headline-lg": ["32px", { lineHeight: "40px", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "label-sm": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "600" }]
                    },
                    spacing: { "gutter": "24px", "container-padding-desktop": "64px", "card-gap": "16px" }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #fff8f6; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-card { background: rgba(255,255,255,0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.3); }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">

<!-- TopNav -->
<header class="fixed top-0 w-full z-50 flex justify-between items-center px-gutter h-16 bg-glass-fill backdrop-blur-md border-b border-glass-stroke shadow-sm">
    <div class="flex items-center gap-4">
        <span class="font-headline-md text-headline-md font-bold text-primary">GAIA</span>
        <div class="hidden md:flex gap-6 items-center ml-8">
            <a href="/Supplier/Index" class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors">Tổng quan</a>
            <a href="/Supplier/Batches" class="text-primary font-bold border-b-2 border-primary pb-1 font-body-md text-body-md">Lô hàng</a>
        </div>
    </div>
    <div class="flex items-center gap-4">
        <span class="text-sm text-on-surface-variant hidden md:block">@Model.SupplierName</span>
        <a href="/Logout" class="text-red-600 flex items-center gap-1 text-sm font-medium hover:text-red-700">
            <span class="material-symbols-outlined text-[18px]">logout</span>
        </a>
    </div>
</header>

<main class="pt-24 pb-12 px-gutter max-w-7xl mx-auto">
    <div class="flex flex-col gap-8">

        <!-- Page header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div>
                <h1 class="font-headline-lg text-headline-lg text-primary">Cập Nhật Trạng Thái Vận Chuyển</h1>
                <p class="text-on-surface-variant font-body-md text-body-md">
                    Mã lô: <span class="font-bold text-secondary">@(Model.Batch?.BatchCode ?? "")</span>
                </p>
            </div>
            <a href="/Supplier/Batches" class="flex items-center gap-2 px-5 py-2.5 rounded-lg border-2 border-secondary text-secondary font-label-sm text-label-sm hover:bg-secondary/5 transition-all">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Quay lại danh sách
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-error-container border border-red-200 p-4 rounded-xl flex items-center gap-3">
                <span class="material-symbols-outlined text-error">error</span>
                <span class="text-on-error-container text-sm">@Model.ErrorMessage</span>
            </div>
        }

        <!-- Bento grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-card-gap">

            <!-- Batch info card -->
            <div class="lg:col-span-4 bg-surface-light rounded-xl p-6 shadow-sm border border-outline-variant/30 flex flex-col gap-5">
                <h3 class="font-label-sm text-label-sm text-outline uppercase tracking-wider">Thông tin lô hàng</h3>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">eco</span>
                    </div>
                    <div>
                        <p class="text-outline font-label-sm text-label-sm">Mã lô</p>
                        <p class="font-headline-md text-headline-md text-on-surface">@(Model.Batch?.BatchCode ?? "—")</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">weight</span>
                    </div>
                    <div>
                        <p class="text-outline font-label-sm text-label-sm">Khối lượng</p>
                        <p class="font-headline-md text-headline-md text-on-surface">@(Model.Batch?.WeightKg.ToString("N2") ?? "—") kg</p>
                    </div>
                </div>
                <div class="p-4 bg-surface-container rounded-lg border-l-4 border-primary">
                    <p class="text-xs font-bold text-primary mb-1">ĐỊA ĐIỂM THU GOM</p>
                    <p class="text-sm text-on-surface-variant">@(Model.Batch?.CollectionAddress ?? "—")</p>
                </div>
                @if (Model.Batch?.ApprovedTime != null)
                {
                    <div class="text-xs text-on-surface-variant">
                        <span class="material-symbols-outlined text-[14px] align-middle">verified</span>
                        Phê duyệt: @Model.Batch.ApprovedTime.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>

            <!-- Progress tracker + Form -->
            <div class="lg:col-span-8 bg-surface-light rounded-xl p-6 shadow-sm border border-outline-variant/30">
                <h3 class="font-label-sm text-label-sm text-outline uppercase tracking-wider mb-8">Tiến trình vận chuyển</h3>

                <!-- Progress steps -->
                <div class="relative px-4 mb-10">
                    <div class="absolute top-5 left-8 right-8 h-1 bg-outline-variant rounded-full">
                        <div class="h-full bg-primary rounded-full transition-all duration-700"
                             style="width: @(progress == 0 ? "0%" : progress == 1 ? "33%" : progress == 2 ? "66%" : "100%")"></div>
                    </div>
                    <div class="flex justify-between relative">
                        @{
                            var steps = new[] {
                                ("inventory_2", "Đã thu gom"),
                                ("verified", "Đã duyệt"),
                                ("local_shipping", "Đang vận chuyển"),
                                ("factory", "Đến nhà máy")
                            };
                        }
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            bool done = i <= progress;
                            <div class="flex flex-col items-center gap-2 w-20">
                                <div class="w-10 h-10 rounded-full @(done ? "bg-primary text-on-primary" : "bg-outline-variant text-white") flex items-center justify-center z-10 @(i == progress ? "ring-4 ring-primary/30" : "")">
                                    <span class="material-symbols-outlined text-xl">@steps[i].Item1</span>
                                </div>
                                <p class="text-xs font-@(done ? "bold" : "medium") text-center @(done ? "text-primary" : "text-outline")">@steps[i].Item2</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Update form -->
                <form method="post" action="/Supplier/Batches/Transportation?batchId=@Model.BatchId" id="transportForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BatchId" value="@Model.BatchId">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <label class="block text-sm font-bold text-on-surface">
                                Cập nhật trạng thái <span class="text-error">*</span>
                            </label>
                            <select name="Input.Status"
                                    class="w-full bg-surface-accent/20 border border-outline-variant rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary text-sm">
                                <option value="Transporting" selected="@(Model.Input.Status == "Transporting")">Đang trên đường vận chuyển (Transporting)</option>
                                <option value="ArrivedFactory" selected="@(Model.Input.Status == "ArrivedFactory")">Đã đến nhà máy (ArrivedFactory)</option>
                            </select>
                            <span asp-validation-for="Input.Status" class="text-error text-xs block"></span>

                            <label class="block text-sm font-bold text-on-surface mt-4">
                                Mô tả chi tiết <span class="text-error">*</span>
                            </label>
                            <textarea name="Input.Description"
                                      rows="3"
                                      placeholder="Nhập mô tả cập nhật vị trí, thời gian, ghi chú..."
                                      class="w-full bg-surface-accent/20 border border-outline-variant rounded-lg p-3 text-on-surface focus:ring-2 focus:ring-primary text-sm resize-none">@Model.Input.Description</textarea>
                            <span asp-validation-for="Input.Description" class="text-error text-xs block"></span>
                        </div>

                        <div class="space-y-3">
                            <label class="block text-sm font-bold text-on-surface">Lịch sử cập nhật</label>
                            @if (!histList.Any())
                            {
                                <div class="flex flex-col items-center justify-center h-36 border-2 border-dashed border-outline-variant rounded-xl text-on-surface-variant">
                                    <span class="material-symbols-outlined text-3xl opacity-30">history</span>
                                    <p class="text-xs mt-2">Chưa có cập nhật nào</p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3 max-h-48 overflow-y-auto pr-1">
                                    @foreach (var h in histList)
                                    {
                                        <div class="flex gap-3">
                                            <div class="w-5 h-5 rounded-full bg-primary flex items-center justify-center shrink-0 mt-0.5">
                                                <div class="w-2 h-2 rounded-full bg-white"></div>
                                            </div>
                                            <div>
                                                <p class="text-sm font-bold text-on-surface">@h.Status</p>
                                                <p class="text-xs text-outline">@h.UpdateTime.ToString("HH:mm dd/MM/yyyy")</p>
                                                <p class="text-xs text-on-surface-variant italic">@h.Description</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Form actions -->
                    <div class="flex flex-col md:flex-row justify-end items-center gap-4 mt-8 pt-6 border-t border-outline-variant/30">
                        <a href="/Supplier/Batches" class="w-full md:w-auto px-6 py-2.5 border-2 border-secondary text-secondary font-label-sm text-label-sm rounded-lg hover:bg-secondary/5 transition-colors text-center text-sm">
                            Hủy bỏ
                        </a>
                        <button type="submit" id="saveBtn"
                                class="w-full md:w-auto px-8 py-2.5 bg-primary text-on-primary font-label-sm text-label-sm rounded-lg shadow-md hover:brightness-110 transition-all flex items-center justify-center gap-2 text-sm">
                            <span class="material-symbols-outlined text-[18px]">save</span> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</main>

<!-- Footer -->
<footer class="w-full py-6 px-container-padding-desktop flex flex-col md:flex-row justify-between items-center bg-surface-container-lowest border-t border-outline-variant">
    <span class="font-headline-md text-headline-md text-primary font-bold text-sm">GAIA</span>
    <p class="text-on-surface-variant font-label-sm text-label-sm text-xs">© 2024 GAIA Sustainable Systems.</p>
</footer>

<script>
    const form = document.getElementById('transportForm');
    const saveBtn = document.getElementById('saveBtn');
    if (form && saveBtn) {
        form.addEventListener('submit', () => {
            saveBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span> Đang lưu...';
            setTimeout(() => { saveBtn.disabled = true; }, 0);
        });
    }
</script>
</body>
</html>
