@page
@model GaiaWeb.Pages.Supplier.Batches.IndexModel
@{
    Layout = "_SupplierLayout";
    ViewData["Title"] = "Lô hàng đã nộp";
    ViewData["PageTitle"] = "Lô Hàng Đã Nộp";
    ViewData["ActivePage"] = "Batches";
}

@section Head {
    <style>
        .status-pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 9999px; font-size: 12px; font-weight: 700; }
    </style>
}

<div class="max-w-6xl mx-auto space-y-6">

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="flex items-center gap-3 bg-green-50 border border-green-200 text-green-800 p-3 rounded-xl text-sm">
            <span class="material-symbols-outlined text-green-600">check_circle</span> @Model.SuccessMessage
        </div>
    }

    <!-- Header -->
    <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-primary mb-1">Lô hàng đã nộp</h1>
            <p class="text-on-surface-variant text-sm">Quản lý và theo dõi trạng thái các lô nguyên liệu – @Model.WarehouseName</p>
        </div>
        <a href="/Supplier/Collection" class="flex items-center gap-2 px-5 py-2.5 bg-primary text-white font-semibold text-sm rounded-xl shadow-md hover:opacity-90 transition-opacity whitespace-nowrap">
            <span class="material-symbols-outlined text-[20px]">add</span> Nộp lô mới
        </a>
    </header>

    <!-- KPI Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-xl shadow-sm border border-outline-variant/30 border-t-4 border-warning-orange">
            <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Chờ xử lý</p>
            <div class="flex items-end gap-2">
                <span class="text-3xl font-bold text-on-surface">@Model.CountPending</span>
                <span class="text-warning-orange mb-1 font-bold text-sm">Lô</span>
            </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-outline-variant/30 border-t-4 border-tertiary">
            <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Đang vận chuyển</p>
            <div class="flex items-end gap-2">
                <span class="text-3xl font-bold text-on-surface">@Model.CountTransporting</span>
                <span class="text-tertiary mb-1 font-bold text-sm">Lô</span>
            </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-outline-variant/30 border-t-4 border-secondary">
            <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Đã đến nhà máy</p>
            <div class="flex items-end gap-2">
                <span class="text-3xl font-bold text-on-surface">@Model.CountArrived</span>
                <span class="text-secondary mb-1 font-bold text-sm">Lô</span>
            </div>
        </div>
        <div class="bg-white p-5 rounded-xl shadow-sm border border-outline-variant/30 border-t-4 border-primary">
            <p class="text-on-surface-variant text-xs font-bold uppercase tracking-wider mb-1">Đã phê duyệt</p>
            <div class="flex items-end gap-2">
                <span class="text-3xl font-bold text-on-surface">@Model.CountApproved</span>
                <span class="text-primary mb-1 font-bold text-sm">Lô</span>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-4">
        <div class="flex items-center p-1 bg-surface-container-high rounded-lg overflow-x-auto gap-1">
            <a href="/Supplier/Batches" class="px-4 py-2 text-sm rounded-md whitespace-nowrap @(string.IsNullOrEmpty(Model.StatusFilter) ? "bg-white text-primary font-bold shadow-sm" : "text-on-surface-variant hover:text-primary font-medium")">Tất cả</a>
            <a href="/Supplier/Batches?statusFilter=Pending" class="px-4 py-2 text-sm rounded-md whitespace-nowrap @(Model.StatusFilter == "Pending" ? "bg-white text-primary font-bold shadow-sm" : "text-on-surface-variant hover:text-primary font-medium")">Chờ xử lý</a>
            <a href="/Supplier/Batches?statusFilter=Transporting" class="px-4 py-2 text-sm rounded-md whitespace-nowrap @(Model.StatusFilter == "Transporting" ? "bg-white text-primary font-bold shadow-sm" : "text-on-surface-variant hover:text-primary font-medium")">Vận chuyển</a>
            <a href="/Supplier/Batches?statusFilter=ArrivedFactory" class="px-4 py-2 text-sm rounded-md whitespace-nowrap @(Model.StatusFilter == "ArrivedFactory" ? "bg-white text-primary font-bold shadow-sm" : "text-on-surface-variant hover:text-primary font-medium")">Đã đến</a>
            <a href="/Supplier/Batches?statusFilter=Approved" class="px-4 py-2 text-sm rounded-md whitespace-nowrap @(Model.StatusFilter == "Approved" ? "bg-white text-primary font-bold shadow-sm" : "text-on-surface-variant hover:text-primary font-medium")">Đã duyệt</a>
        </div>
        <span class="text-sm text-on-surface-variant">Hiển thị <strong>@Model.Batches.Count</strong> lô hàng</span>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-outline-variant/30">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-surface-container-low border-b border-outline-variant/30">
                    <tr>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant">Mã lô</th>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant">Ngày tạo</th>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant">Địa chỉ thu gom</th>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant">Khối lượng (kg)</th>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant">Trạng thái</th>
                        <th class="px-5 py-4 font-bold text-xs uppercase tracking-wider text-on-surface-variant text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/10 text-sm">
                    @if (!Model.Batches.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-5xl block mb-2 opacity-30">inventory_2</span>
                                <p class="text-sm">Chưa có lô hàng nào. <a href="/Supplier/Collection" class="text-primary font-semibold hover:underline">Tạo lô mới →</a></p>
                            </td>
                        </tr>
                    }
                    @foreach (var batch in Model.Batches)
                    {
                        <tr class="hover:bg-primary/5 transition-colors group">
                            <td class="px-5 py-4 font-mono font-bold text-primary">@batch.BatchCode</td>
                            <td class="px-5 py-4 text-on-surface">@batch.CreatedDate.ToString("dd/MM/yyyy")</td>
                            <td class="px-5 py-4 max-w-[220px]">
                                <span class="block truncate" title="@batch.CollectionAddress">@batch.CollectionAddress</span>
                            </td>
                            <td class="px-5 py-4 font-bold">@batch.WeightKg.ToString("N2")</td>
                            <td class="px-5 py-4">
                                @{
                                    var (pillBg, pillText, icon) = batch.Status switch {
                                        "Pending"       => ("bg-yellow-50 text-yellow-700",   "bg-yellow-50 text-yellow-700", "schedule"),
                                        "Approved"      => ("bg-green-50 text-green-700",     "bg-green-50 text-green-700",   "check_circle"),
                                        "Rejected"      => ("bg-red-50 text-red-700",         "bg-red-50 text-red-700",       "cancel"),
                                        "Transporting"  => ("bg-blue-50 text-blue-700",       "bg-blue-50 text-blue-700",     "local_shipping"),
                                        "ArrivedFactory"=> ("bg-purple-50 text-purple-700",   "bg-purple-50 text-purple-700", "inventory_2"),
                                        _               => ("bg-gray-50 text-gray-700",        "bg-gray-50 text-gray-700",     "help")
                                    };
                                    string label = batch.Status switch {
                                        "Pending"        => "Chờ xử lý",
                                        "Approved"       => "Đã phê duyệt",
                                        "Rejected"       => "Từ chối",
                                        "Transporting"   => "Đang vận chuyển",
                                        "ArrivedFactory" => "Đã đến nhà máy",
                                        _                => batch.Status
                                    };
                                }
                                <span class="status-pill @pillBg">
                                    <span class="material-symbols-outlined text-[14px]">@icon</span> @label
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex justify-center gap-1">
                                    @if (batch.Status == "Pending")
                                    {
                                        <a href="/Supplier/Batches/Edit?batchId=@batch.BatchId"
                                           title="Chỉnh sửa"
                                           class="p-2 text-on-surface-variant hover:bg-surface-container-low rounded-full transition-all">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>
                                    }
                                    @if (batch.Status == "Approved" || batch.Status == "Transporting")
                                    {
                                        <a href="/Supplier/Batches/Transportation?batchId=@batch.BatchId"
                                           title="Cập nhật vận chuyển"
                                           class="p-2 text-tertiary hover:bg-blue-50 rounded-full transition-all">
                                            <span class="material-symbols-outlined text-[20px]">local_shipping</span>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Motivational Banner -->
    <div class="rounded-2xl overflow-hidden bg-gradient-to-r from-primary to-secondary p-8 text-white text-center shadow-md">
        <h3 class="font-headline-md text-headline-md font-bold mb-2">Cam kết Bền vững</h3>
        <p class="text-white/80 text-sm max-w-xl mx-auto">Mỗi lô hàng bạn nộp góp phần vào vòng tròn kinh tế tuần hoàn. Cùng GAIA giảm thiểu rác thải từ vỏ sầu riêng.</p>
    </div>
</div>
