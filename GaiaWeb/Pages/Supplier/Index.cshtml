@page
@model GaiaWeb.Pages.Supplier.IndexModel
@{
    Layout = "_SupplierLayout";
    ViewData["Title"] = "Tổng quan";
    ViewData["PageTitle"] = "Tổng Quan";
    ViewData["ActivePage"] = "Overview";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Welcome header -->
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-outline-variant/30">
        <h1 class="text-2xl font-bold text-on-surface mb-2">Chào mừng, @Model.UserName!</h1>
        <p class="text-on-surface-variant mb-6">Quản lý thu gom nguyên liệu và theo dõi trạng thái lô hàng tại <strong>@HttpContext.Session.GetString("WarehouseName")</strong>.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <a href="/Supplier/Collection" class="border border-green-100 p-6 rounded-xl bg-green-50 flex items-start gap-4 hover:bg-green-100 hover:shadow-md transition-all group">
                <span class="material-symbols-outlined text-primary text-[32px] group-hover:scale-110 transition-transform shrink-0">add_circle</span>
                <div>
                    <h3 class="font-bold text-on-surface">Tạo phiếu thu gom mới</h3>
                    <p class="text-sm text-on-surface-variant mt-1">Nhập thông tin thu gom, upload ảnh xác minh và gửi lô nguyên liệu mới.</p>
                    <span class="inline-block mt-2 text-primary text-sm font-semibold group-hover:underline">Bắt đầu ngay →</span>
                </div>
            </a>
            <a href="/Supplier/Batches" class="border border-blue-100 p-6 rounded-xl bg-blue-50 flex items-start gap-4 hover:bg-blue-100 hover:shadow-md transition-all group">
                <span class="material-symbols-outlined text-primary text-[32px] group-hover:scale-110 transition-transform shrink-0">inventory_2</span>
                <div>
                    <h3 class="font-bold text-on-surface">Quản lý lô nguyên liệu</h3>
                    <p class="text-sm text-on-surface-variant mt-1">Xem, chỉnh sửa hoặc theo dõi trạng thái các lô nguyên liệu đã gửi.</p>
                    <span class="inline-block mt-2 text-primary text-sm font-semibold group-hover:underline">Xem danh sách →</span>
                </div>
            </a>
            <div class="border border-outline-variant/30 p-6 rounded-xl bg-surface-container-low flex items-start gap-4 opacity-70">
                <span class="material-symbols-outlined text-primary text-[32px] shrink-0">local_shipping</span>
                <div>
                    <h3 class="font-bold text-on-surface">Lịch sử vận chuyển</h3>
                    <p class="text-sm text-on-surface-variant mt-1">Cập nhật và theo dõi các cột mốc vận chuyển của lô hàng về nhà máy GAIA.</p>
                    <span class="inline-block mt-2 text-on-surface-variant text-sm italic">Sắp ra mắt</span>
                </div>
            </div>
        </div>
    </div>
</div>
