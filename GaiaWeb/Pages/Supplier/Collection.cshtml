@page
@model GaiaWeb.Pages.Supplier.CollectionModel
@{
    Layout = null;
    string collectionTimeValue = Model.Input.CollectionTime == default
        ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm")
        : Model.Input.CollectionTime.ToString("yyyy-MM-ddTHH:mm");
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phiếu thu gom mới | GAIA Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .glass-card { background: rgba(255,255,255,0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255,255,255,0.3); }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "error": "#ba1a1a",
                        "surface-light": "#FFFFFF",
                        "surface": "#fff8f6",
                        "surface-accent": "#C8E6C9",
                        "glass-fill": "rgba(255,255,255,0.7)",
                        "glass-stroke": "rgba(255,255,255,0.3)",
                        "surface-container-low": "#fff1ec",
                        "surface-container-high": "#ffe2d9",
                        "surface-container-highest": "#ffdbce",
                        "surface-container": "#ffe9e2",
                        "surface-variant": "#ffdbce",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a",
                        "on-surface-variant": "#40493d",
                        "on-primary": "#ffffff",
                        "on-surface": "#2b160f",
                        "outline-variant": "#bfcaba",
                        "outline": "#707a6c",
                        "background": "#fff8f6",
                        "on-background": "#2b160f",
                        "primary": "#0d631b",
                        "primary-container": "#2e7d32",
                        "on-primary-container": "#cbffc2",
                        "secondary": "#006e1c",
                        "secondary-container": "#91f78e",
                        "on-secondary-container": "#00731e",
                        "on-secondary": "#ffffff",
                        "warning-orange": "#FF9800"
                    },
                    spacing: {
                        "container-padding-desktop": "64px",
                        "container-padding-mobile": "20px",
                        "base": "8px"
                    },
                    fontFamily: {
                        "headline-md": ["Inter"],
                        "body-md": ["Inter"],
                        "label-sm": ["Inter"]
                    },
                    fontSize: {
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "label-sm": ["14px", { lineHeight: "20px", letterSpacing: "0.05em", fontWeight: "600" }]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-surface text-on-surface">
<div class="flex min-h-screen">

    <!-- SideNav -->
    <aside class="h-screen w-64 hidden md:flex flex-col border-r border-outline-variant bg-surface-container-low py-base sticky top-0">
        <div class="px-6 py-8">
            <h1 class="font-headline-md text-headline-md text-primary">GAIA</h1>
            <p class="font-label-sm text-label-sm text-on-surface-variant opacity-70">Cổng Nhà Cung Cấp</p>
        </div>
        <nav class="flex-1 space-y-1 px-2">
            <a href="/Supplier/Index" class="flex items-center text-on-surface-variant hover:bg-surface-variant/30 rounded-xl px-4 py-3 transition-all hover:translate-x-1">
                <span class="material-symbols-outlined mr-3">dashboard</span>
                <span class="font-label-sm text-label-sm">Tổng quan</span>
            </a>
            <a href="/Supplier/Batches" class="flex items-center text-on-surface-variant hover:bg-surface-variant/30 rounded-xl px-4 py-3 transition-all hover:translate-x-1">
                <span class="material-symbols-outlined mr-3">inventory_2</span>
                <span class="font-label-sm text-label-sm">Lô hàng</span>
            </a>
            <a href="/Supplier/Collection" class="flex items-center bg-secondary-container text-on-secondary-container rounded-xl px-4 py-3 font-semibold">
                <span class="material-symbols-outlined mr-3">recycling</span>
                <span class="font-label-sm text-label-sm">Thu gom mới</span>
            </a>
        </nav>
        <div class="mt-auto border-t border-outline-variant pt-4 pb-6 px-2">
            <div class="flex items-center px-4 mb-4">
                <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold text-sm">
                    @(Model.SupplierName.Length > 0 ? Model.SupplierName[0].ToString() : "S")
                </div>
                <div class="ml-3">
                    <p class="font-label-sm text-label-sm font-bold truncate">@Model.WarehouseName</p>
                    <p class="text-xs text-on-surface-variant truncate">@Model.SupplierName</p>
                </div>
            </div>
            <a href="/Logout" class="flex items-center text-on-surface-variant hover:bg-surface-variant/30 rounded-xl px-4 py-3 transition-all">
                <span class="material-symbols-outlined mr-3">logout</span>
                <span class="font-label-sm text-label-sm">Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- Main -->
    <main class="flex-1 flex flex-col h-screen overflow-hidden">

        <!-- Header -->
        <header class="flex justify-between items-center w-full px-6 md:px-12 py-4 bg-glass-fill backdrop-blur-md border-b border-glass-stroke shadow-sm sticky top-0 z-50">
            <h2 class="font-headline-md text-headline-md font-extrabold text-primary">Phiếu thu gom mới</h2>
            <div class="flex items-center space-x-3">
                <span class="text-sm text-on-surface-variant hidden md:block">Xin chào, <strong>@Model.SupplierName</strong></span>
                <a href="/Logout" class="text-red-600 hover:text-red-700 flex items-center gap-1 text-sm font-medium">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                </a>
            </div>
        </header>

        <!-- Scrollable content -->
        <div class="flex-1 overflow-y-auto p-4 md:p-8 bg-surface">
            <div class="max-w-4xl mx-auto pb-12 space-y-6">

                <!-- Alert messages -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="flex items-start gap-3 bg-green-50 border border-green-200 text-green-800 p-4 rounded-xl">
                        <span class="material-symbols-outlined text-green-600 text-[22px] mt-0.5">check_circle</span>
                        <span>@Model.SuccessMessage</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="flex items-start gap-3 bg-error-container border border-red-200 p-4 rounded-xl">
                        <span class="material-symbols-outlined text-error text-[22px] mt-0.5">error</span>
                        <span class="text-on-error-container">@Model.ErrorMessage</span>
                    </div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-error-container border border-red-200 p-4 rounded-xl">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="material-symbols-outlined text-error text-[22px]">error</span>
                            <span class="font-label-sm font-semibold text-on-error-container">Vui lòng kiểm tra lại thông tin:</span>
                        </div>
                        <ul class="list-disc list-inside text-sm text-on-error-container pl-2 space-y-1">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <!-- Progress Steps -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-sm">1</div>
                        <div class="h-1 w-10 bg-primary rounded-full"></div>
                        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-secondary-container text-on-secondary-container font-bold text-sm">2</div>
                        <div class="h-1 w-10 bg-outline-variant rounded-full"></div>
                        <div class="flex items-center justify-center w-10 h-10 rounded-full border-2 border-outline-variant text-outline font-bold text-sm">3</div>
                    </div>
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest text-xs">Nhập liệu</span>
                </div>

                <!-- THE FORM (plain form, not tag helper) -->
                <form method="post" enctype="multipart/form-data" id="collectionForm" action="/Supplier/Collection">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Input.Latitude" id="latInput" value="@Model.DefaultLatitude">
                    <input type="hidden" name="Input.Longitude" id="lngInput" value="@Model.DefaultLongitude">

                    <!-- Section 1: Supplier Info + Metadata -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

                        <!-- Supplier Info (read-only) -->
                        <div class="md:col-span-2 glass-card rounded-xl p-6 shadow-sm">
                            <div class="flex items-center mb-5">
                                <span class="material-symbols-outlined text-primary mr-3">person</span>
                                <h3 class="font-headline-md text-headline-md text-on-surface">Thông tin nhà cung cấp</h3>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div>
                                    <label class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">Tên người liên hệ</label>
                                    <input type="text" value="@Model.SupplierName" readonly class="w-full rounded-xl border-none bg-surface-accent/20 px-4 py-3 text-on-surface-variant cursor-not-allowed text-sm">
                                </div>
                                <div>
                                    <label class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">Số điện thoại</label>
                                    <input type="tel" value="@Model.SupplierPhone" readonly class="w-full rounded-xl border-none bg-surface-accent/20 px-4 py-3 text-on-surface-variant cursor-not-allowed text-sm">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">Tên cơ sở thu gom</label>
                                    <input type="text" value="@Model.WarehouseName" readonly class="w-full rounded-xl border-none bg-surface-accent/20 px-4 py-3 text-on-surface-variant cursor-not-allowed text-sm">
                                </div>
                            </div>
                        </div>

                        <!-- Metadata sidebar -->
                        <div class="glass-card rounded-xl p-6 shadow-sm border-l-4 border-primary">
                            <div class="flex items-center mb-5">
                                <span class="material-symbols-outlined text-primary mr-3">info</span>
                                <h3 class="font-headline-md text-headline-md text-on-surface">Metadata</h3>
                            </div>
                            <div class="space-y-3">
                                <div class="bg-surface-container-low p-3 rounded-lg">
                                    <p class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                                        <span class="material-symbols-outlined text-base">calendar_today</span> Thời gian
                                    </p>
                                    <p class="font-mono font-bold text-xs mt-1">@Model.Now.ToString("yyyy-MM-dd | HH:mm:ss")</p>
                                </div>
                                <div class="bg-surface-container-low p-3 rounded-lg">
                                    <p class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                                        <span class="material-symbols-outlined text-base">location_on</span> Tọa độ
                                    </p>
                                    <p class="font-mono font-bold text-xs mt-1">@Model.DefaultLatitude.ToString("F4")°N, @Model.DefaultLongitude.ToString("F4")°E</p>
                                </div>
                                <div class="flex items-center text-primary text-xs font-bold pt-1">
                                    <span class="material-symbols-outlined text-sm mr-1">lock</span> Mã lô: Auto-generated
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Material Info + Image Upload -->
                    <div class="glass-card rounded-xl p-6 shadow-sm mb-6">
                        <div class="flex items-center mb-6">
                            <span class="material-symbols-outlined text-primary mr-3">eco</span>
                            <h3 class="font-headline-md text-headline-md text-on-surface">Chi tiết nguyên liệu &amp; thu gom</h3>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                            <!-- Left: form fields -->
                            <div class="space-y-5">
                                <div>
                                    <label for="collectionAddress" class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">
                                        Địa chỉ thu gom <span class="text-error">*</span>
                                    </label>
                                    <textarea id="collectionAddress"
                                              name="Input.CollectionAddress"
                                              rows="3"
                                              class="w-full rounded-xl border border-outline-variant bg-surface-accent/20 px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all text-sm"
                                              placeholder="Nhập địa chỉ chi tiết điểm thu gom">@Model.Input.CollectionAddress</textarea>
                                    <span asp-validation-for="Input.CollectionAddress" class="text-error text-xs mt-1 block"></span>
                                </div>

                                <div>
                                    <label for="weightKg" class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">
                                        Tổng trọng lượng (kg) <span class="text-error">*</span>
                                    </label>
                                    <div class="relative">
                                        <input id="weightKg"
                                               name="Input.WeightKg"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               value="@(Model.Input.WeightKg > 0 ? Model.Input.WeightKg.ToString() : "")"
                                               placeholder="0.00"
                                               class="w-full rounded-xl border border-outline-variant bg-surface-accent/20 px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all text-sm pr-14">
                                        <span class="absolute right-4 top-3 text-on-surface-variant font-bold text-sm">KG</span>
                                    </div>
                                    <span asp-validation-for="Input.WeightKg" class="text-error text-xs mt-1 block"></span>
                                </div>

                                <div>
                                    <label for="collectionTime" class="font-label-sm text-label-sm text-on-surface-variant mb-1 block">
                                        Thời gian thu gom <span class="text-error">*</span>
                                    </label>
                                    <input id="collectionTime"
                                           name="Input.CollectionTime"
                                           type="datetime-local"
                                           value="@collectionTimeValue"
                                           class="w-full rounded-xl border border-outline-variant bg-surface-accent/20 px-4 py-3 focus:ring-2 focus:ring-primary focus:border-primary transition-all text-sm">
                                    <span asp-validation-for="Input.CollectionTime" class="text-error text-xs mt-1 block"></span>
                                </div>
                            </div>

                            <!-- Right: image upload -->
                            <div class="flex flex-col">
                                <label class="font-label-sm text-label-sm text-on-surface-variant mb-2 block">
                                    Ảnh xác minh (tối đa 5 ảnh, PNG/JPG, max 10MB)
                                </label>
                                <div id="dropZone"
                                     class="flex-1 border-2 border-dashed border-primary/40 rounded-2xl bg-primary/5 flex flex-col items-center justify-center p-6 text-center group hover:bg-primary/10 transition-all cursor-pointer min-h-[160px]">
                                    <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                                        <span class="material-symbols-outlined text-primary text-2xl">cloud_upload</span>
                                    </div>
                                    <p class="font-body-md font-bold text-on-surface text-sm">Kéo &amp; Thả ảnh vào đây</p>
                                    <p class="text-on-surface-variant text-xs mt-1">hoặc nhấp để chọn từ thiết bị</p>
                                    <p class="text-outline text-[10px] mt-3 uppercase tracking-widest">PNG, JPG – Tối đa 5 ảnh</p>
                                </div>
                                <input type="file" id="imageFileInput" name="Input.Images" multiple accept="image/png,image/jpeg" class="hidden">
                                <div id="previewGrid" class="mt-3 grid grid-cols-4 gap-2"></div>
                                <p id="previewCount" class="text-xs text-on-surface-variant mt-2 text-right hidden">
                                    <span id="countText"></span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Form actions -->
                    <div class="flex flex-col md:flex-row justify-end items-center gap-4 pt-2">
                        <a href="/Supplier/Index" class="w-full md:w-auto px-8 py-3 border-2 border-primary text-primary font-bold rounded-xl hover:bg-primary/5 transition-all text-center text-sm">
                            Quay lại
                        </a>
                        <button type="submit" id="submitBtn"
                                class="w-full md:w-auto px-10 py-3 bg-primary text-white font-bold rounded-xl shadow-lg shadow-primary/20 hover:bg-primary-container hover:text-on-primary-container transition-all flex items-center justify-center gap-2 text-sm">
                            <span class="material-symbols-outlined mr-1">send</span>
                            Gửi phiếu thu gom
                        </button>
                    </div>
                </form>

            </div>
        </div>

        <!-- Footer -->
        <footer class="bg-surface-container-highest border-t border-outline-variant px-8 py-4 flex justify-between items-center">
            <span class="font-headline-md text-headline-md text-on-surface text-sm font-bold">GAIA</span>
            <p class="font-label-sm text-label-sm text-on-surface-variant text-xs opacity-70">© 2024 GAIA. Kết nối Công nghệ &amp; Sự bền vững.</p>
        </footer>
    </main>
</div>

<!-- Mobile bottom nav -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 bg-glass-fill backdrop-blur-md border-t border-glass-stroke grid grid-cols-4 py-3 z-50">
    <a href="/Supplier/Index" class="flex flex-col items-center text-on-surface-variant">
        <span class="material-symbols-outlined text-[22px]">dashboard</span>
        <span class="text-[10px] font-bold">Trang chủ</span>
    </a>
    <a href="/Supplier/Batches" class="flex flex-col items-center text-on-surface-variant">
        <span class="material-symbols-outlined text-[22px]">inventory_2</span>
        <span class="text-[10px] font-bold">Lô hàng</span>
    </a>
    <a href="/Supplier/Collection" class="flex flex-col items-center text-primary">
        <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">recycling</span>
        <span class="text-[10px] font-bold">Thu gom</span>
    </a>
    <a href="/Logout" class="flex flex-col items-center text-on-surface-variant">
        <span class="material-symbols-outlined text-[22px]">logout</span>
        <span class="text-[10px] font-bold">Đăng xuất</span>
    </a>
</nav>

<script>
    // UC10: drag-and-drop image upload
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('imageFileInput');
    const previewGrid = document.getElementById('previewGrid');
    const previewCount = document.getElementById('previewCount');
    const countText = document.getElementById('countText');
    const MAX = 5;
    let selectedFiles = [];

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('bg-primary/15', 'border-primary');
    });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('bg-primary/15', 'border-primary'));
    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('bg-primary/15', 'border-primary');
        handleFiles([...e.dataTransfer.files]);
    });
    fileInput.addEventListener('change', () => handleFiles([...fileInput.files]));

    function handleFiles(newFiles) {
        const valid = newFiles.filter(f => f.type === 'image/jpeg' || f.type === 'image/png');
        const toAdd = valid.slice(0, MAX - selectedFiles.length);
        if (!toAdd.length && newFiles.length) { alert('Chỉ chấp nhận PNG/JPG, tối đa 5 ảnh.'); return; }
        selectedFiles = [...selectedFiles, ...toAdd];
        const dt = new DataTransfer();
        selectedFiles.forEach(f => dt.items.add(f));
        fileInput.files = dt.files;
        renderPreviews();
    }

    function renderPreviews() {
        previewGrid.innerHTML = '';
        selectedFiles.forEach((file, idx) => {
            const reader = new FileReader();
            reader.onload = e => {
                const wrap = document.createElement('div');
                wrap.className = 'aspect-square rounded-lg overflow-hidden relative group bg-surface-variant';
                wrap.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 flex items-center justify-center cursor-pointer transition-opacity" data-idx="${idx}">
                        <span class="material-symbols-outlined text-white">delete</span>
                    </div>`;
                wrap.querySelector('[data-idx]').addEventListener('click', () => {
                    selectedFiles.splice(idx, 1);
                    const dt = new DataTransfer();
                    selectedFiles.forEach(f => dt.items.add(f));
                    fileInput.files = dt.files;
                    renderPreviews();
                });
                previewGrid.appendChild(wrap);
            };
            reader.readAsDataURL(file);
        });
        previewCount.classList.toggle('hidden', !selectedFiles.length);
        countText.textContent = selectedFiles.length + '/' + MAX + ' ảnh đã chọn';
    }

    const form = document.getElementById('collectionForm');
    const submitBtn = document.getElementById('submitBtn');
    if (form && submitBtn) {
        form.addEventListener('submit', () => {
            submitBtn.innerHTML = '<span class="material-symbols-outlined mr-1 animate-spin">refresh</span> Đang xử lý...';
            setTimeout(() => { submitBtn.disabled = true; }, 0);
        });
    }
</script>
</body>
</html>
