        <button id="mobile-menu-btn" class="md:hidden material-symbols-outlined p-2 text-on-surface-variant">menu</button>
    </div>
</header>

<main class="pt-32 pb-section-margin px-container-padding-mobile md:px-container-padding-desktop max-w-[1440px] mx-auto">
