@page
@model GaiaWeb.Pages.Products.IndexModel
@{
    ViewData["Title"] = "GAIA | Bộ sưu tập Signature";
    Layout = "_GuestLayout";
}

<!-- TopNavBar -->
<header id="main-header" class="fixed top-0 w-full z-50 bg-glass-fill backdrop-blur-md border-b border-glass-stroke shadow-sm h-20 flex justify-between items-center px-container-padding-mobile md:px-container-padding-desktop transition-all duration-300">
    <a asp-page="/Index" class="font-display-hero text-headline-md font-extrabold text-primary cursor-pointer transition-transform active:scale-95 no-underline">GAIA</a>
    <nav class="hidden md:flex items-center gap-8">
        <a class="text-primary font-bold border-b-2 border-primary pb-1 font-label-sm text-label-sm uppercase tracking-wider" href="#">Bộ sưu tập</a>
        <a asp-page="/Index" class="text-on-surface-variant hover:text-primary transition-colors font-label-sm text-label-sm uppercase tracking-wider">Câu chuyện</a>
        <a href="#impact-section" class="text-on-surface-variant hover:text-primary transition-colors font-label-sm text-label-sm uppercase tracking-wider">Tác động</a>
