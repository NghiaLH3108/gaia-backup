<script>
        // Intersection Observer for scroll reveal animations
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.scroll-reveal').forEach(el => {
            observer.observe(el);
        });

        const originMapButton = document.getElementById('show-origin-map');
        const originGalleryButton = document.getElementById('show-origin-gallery');
        const originGallery = document.getElementById('origin-gallery');
        const originMapPanel = document.getElementById('origin-map-panel');
        const originMapFrame = document.getElementById('origin-map-frame');
        const originMapEmpty = document.getElementById('origin-map-empty');
        const originLocation = {
            latitude: Number('@mapLatitude'),
            longitude: Number('@mapLongitude'),
            address: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(batch?.CollectionAddress ?? "Khong co du lieu dia chi")),
            batchCode: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(batch?.BatchCode ?? ""))
        };
        let originMap;

        function hasValidOriginCoordinates() {
            return Number.isFinite(originLocation.latitude)
                && Number.isFinite(originLocation.longitude)
                && Math.abs(originLocation.latitude) <= 90
                && Math.abs(originLocation.longitude) <= 180
                && !(originLocation.latitude === 0 && originLocation.longitude === 0);
        }

        function initializeOriginMap() {
            if (originMap) {
                return;
            }

            if (typeof L === 'undefined') {
                if (originMapEmpty) {
                    originMapEmpty.textContent = 'Không tải được bản đồ OpenStreetMap. Vui lòng kiểm tra kết nối mạng.';
                    originMapEmpty.classList.remove('hidden');
                }
                return;
            }

            const vietnamCenter = [16.0471, 108.2068];
            const vietnamBounds = [[8.18, 102.14], [23.39, 109.46]];
            const hasCoordinates = hasValidOriginCoordinates();
            const markerCenter = [originLocation.latitude, originLocation.longitude];

            originMap = L.map('origin-map', {
                zoomControl: false,
                scrollWheelZoom: false,
                doubleClickZoom: false,
                boxZoom: false,
                maxBounds: vietnamBounds,
                maxBoundsViscosity: 0.4
            });

            const originTiles = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 10,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(originMap);

            originTiles.on('tileerror', () => {
                if (originMapEmpty) {
                    originMapEmpty.textContent = 'Không tải được nền bản đồ OpenStreetMap. Vui lòng kiểm tra kết nối mạng hoặc thử tải lại trang.';
                    originMapEmpty.classList.remove('hidden');
                }
            });

            originMap.fitBounds(vietnamBounds, {
                padding: [20, 20],
                animate: false
            });

            if (hasCoordinates) {
                const popupLines = [
                    '<strong>Nguồn gốc thu gom</strong>',
                    originLocation.address,
                    originLocation.batchCode ? `Mã lô: ${originLocation.batchCode}` : '',
                    `Vĩ độ: ${originLocation.latitude.toFixed(4)} | Kinh độ: ${originLocation.longitude.toFixed(4)}`
                ].filter(Boolean).join('<br>');

                L.circleMarker(markerCenter, {
                    radius: 8,
                    color: '#ffffff',
                    weight: 3,
                    fillColor: '#d71920',
                    fillOpacity: 1,
                    interactive: false
                }).addTo(originMap);
            } else if (originMapEmpty) {
                originMapEmpty.classList.remove('hidden');
            }
        }

        function showOriginMap() {
            originGallery?.classList.add('hidden');
            originMapPanel?.classList.remove('hidden');
            if (originMapFrame && !originMapFrame.src) {
                originMapFrame.src = originMapFrame.dataset.src;
            }
        }

        function showOriginGallery() {
            originMapPanel?.classList.add('hidden');
            originGallery?.classList.remove('hidden');
        }

        originMapButton?.addEventListener('click', showOriginMap);
        originGalleryButton?.addEventListener('click', showOriginGallery);

        // Simple parallax effect for hero
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const heroBg = document.querySelector('.parallax-bg');
            if (heroBg) {
                heroBg.style.transform = `translateY(${scrolled * 0.4}px)`;
            }
        });
    </script>
</body></html>
