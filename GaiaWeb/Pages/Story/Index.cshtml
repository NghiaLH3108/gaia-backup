@page
@model GaiaWeb.Pages.Story.IndexModel
@{
    Layout = null;
    var product = Model.ProductInfo;
    if (product == null) return;
    
    var batch = product.Batch;
    var image = batch?.MaterialImages?.FirstOrDefault();
    
    // Get timelines by index safely
    var timelines = product.ProductTimelines?.ToList() ?? new List<GaiaWeb.DAL.Models.ProductTimeline>();
    var timeline1 = timelines.ElementAtOrDefault(0);
    var timeline2 = timelines.ElementAtOrDefault(1);
    var timeline3 = timelines.ElementAtOrDefault(2);
    
    // Get stories
    var stories = product.Stories?.ToList() ?? new List<GaiaWeb.DAL.Models.Story>();
    var story1 = stories.ElementAtOrDefault(0);
    var storyEnv = stories.FirstOrDefault(s => s.DisplayOrder == 4) ?? stories.ElementAtOrDefault(3);
    var storyCompost = stories.FirstOrDefault(s => s.DisplayOrder == 5) ?? stories.ElementAtOrDefault(4);
    
    var mapLatitude = batch != null ? batch.Latitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) : "";
    var mapLongitude = batch != null ? batch.Longitude.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) : "";
    var googleMapsEmbedUrl = !string.IsNullOrWhiteSpace(mapLatitude) && !string.IsNullOrWhiteSpace(mapLongitude)
        ? $"https://www.google.com/maps?q={mapLatitude},{mapLongitude}&z=9&output=embed&hl=vi"
        : "https://www.google.com/maps?q=Vi%E1%BB%87t%20Nam&z=5&output=embed&hl=vi";
}
<!DOCTYPE html><html class="light" lang="vi"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>GAIA | @product.ProductName</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<style>
        body { font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .parallax-bg {
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
        }
        .text-gradient {
            background: linear-gradient(135deg, #0d631b 0%, #00598f 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .timeline-track {
            background: repeating-linear-gradient(to right, transparent, transparent 10px, #bfcaba 10px, #bfcaba 12px);
        }
        .hero-scrim {
            background: linear-gradient(
                180deg,
                rgba(255, 248, 246, 0.18) 0%,
                rgba(255, 248, 246, 0.78) 52%,
                rgba(255, 248, 246, 0.96) 100%
            );
        }
        .hero-title {
            color: #075514;
            text-shadow: 0 2px 12px rgba(255, 248, 246, 0.95), 0 1px 2px rgba(0, 0, 0, 0.18);
        }
        .hero-description {
            color: #2b160f;
            font-weight: 600;
            text-shadow: 0 1px 10px rgba(255, 248, 246, 0.96), 0 1px 2px rgba(255, 255, 255, 0.85);
        }
        .timeline-marker {
            top: 2rem !important;
            right: 2rem;
            left: auto !important;
            transform: none !important;
            width: 4rem;
            height: 4rem;
            opacity: 0.16;
            pointer-events: none;
            z-index: 20;
        }
        .timeline-card {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.82);
        }
        .origin-card {
            text-align: left;
            width: 100%;
        }
        .origin-card:focus-visible {
            outline: 3px solid rgba(13, 99, 27, 0.35);
            outline-offset: 4px;
        }
        .origin-layout {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            align-items: start;
        }
        .origin-visuals {
            min-width: 0;
        }
        @@media (min-width: 768px) {
            .origin-layout {
                grid-template-columns: minmax(0, 1fr) minmax(320px, 440px);
            }
        }
        @@media (min-width: 1024px) {
            .origin-layout {
                gap: 4rem;
            }
        }
        .origin-map {
            height: 360px;
            min-height: 0;
            width: 100%;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }
        .origin-map-frame {
            display: block;
            border: 0;
            background: #eef4ee;
        }
        .origin-map.leaflet-container,
        .origin-map .leaflet-map-pane,
        .origin-map .leaflet-tile,
        .origin-map .leaflet-pane,
        .origin-map .leaflet-tile-container,
        .origin-map .leaflet-overlay-pane,
        .origin-map .leaflet-marker-pane,
        .origin-map .leaflet-shadow-pane {
            position: absolute;
            left: 0;
            top: 0;
        }
        .origin-map.leaflet-container {
            position: relative;
            overflow: hidden;
        }
        .origin-map .leaflet-pane,
        .origin-map .leaflet-map-pane {
            z-index: 1;
        }
        .origin-map .leaflet-tile-pane {
            z-index: 200;
        }
        .origin-map .leaflet-overlay-pane {
            z-index: 400;
        }
        .origin-map .leaflet-marker-pane {
            z-index: 600;
        }
        .origin-map .leaflet-tile {
            width: 256px;
            height: 256px;
            border: 0;
            visibility: inherit;
            user-select: none;
        }
        .origin-map .leaflet-control-container .leaflet-control {
            position: relative;
            z-index: 800;
            pointer-events: auto;
        }
        .origin-map .leaflet-bottom,
        .origin-map .leaflet-top {
            position: absolute;
            z-index: 1000;
            pointer-events: none;
        }
        .origin-map .leaflet-top {
            top: 0;
        }
        .origin-map .leaflet-bottom {
            bottom: 0;
        }
        .origin-map .leaflet-right {
            right: 0;
        }
        .origin-map .leaflet-left {
            left: 0;
        }
        .origin-map .leaflet-control-attribution {
            margin: 0;
            padding: 2px 6px;
            background: rgba(255, 255, 255, 0.82);
            color: #40493d;
            font-size: 11px;
            line-height: 1.4;
        }
        .origin-map .leaflet-control-attribution a {
            color: #0d631b;
            text-decoration: none;
        }
        .origin-dot {
            width: 18px;
            height: 18px;
            background: #d71920;
            border: 3px solid #ffffff;
            border-radius: 9999px;
            box-shadow: 0 0 0 8px rgba(215, 25, 32, 0.18), 0 8px 20px rgba(43, 22, 15, 0.25);
        }
        .origin-dot-marker {
            background: transparent;
            border: 0;
        }
        .leaflet-container {
            font-family: 'Inter', sans-serif;
        }
        .scroll-reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s ease-out;
        }
        .scroll-reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
