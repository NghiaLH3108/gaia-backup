}
</div>
</div>
<div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
<span class="material-symbols-outlined text-primary text-4xl">keyboard_arrow_down</span>
</div>
</section>
<!-- Narrative Section: My Previous Life -->
