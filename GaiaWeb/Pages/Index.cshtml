@page
@model IndexModel
@{
    ViewData["Title"] = "GAIA - Transforming Waste into Crafted Living";
    Layout = "_GuestLayout";
}

<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-glass-fill border-b border-glass-stroke shadow-sm transition-all duration-300">
    <div class="flex justify-between items-center h-20 px-container-padding-mobile md:px-container-padding-desktop max-w-full">
        <a asp-page="/Index" class="font-headline-md text-headline-md font-black tracking-tighter text-primary no-underline">GAIA</a>
        <div class="hidden md:flex gap-8 items-center">
            <a class="font-label-sm text-label-sm uppercase tracking-wider text-primary border-b-2 border-primary pb-1" href="#story">Câu chuyện</a>
            <a class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors" href="#collection">Sản phẩm</a>
            <a class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors" href="#traceability">Truy xuất nguồn gốc</a>
            <a class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors" href="#process">Quy trình</a>
            <a class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant hover:text-primary transition-colors" href="#impact">Sứ mệnh</a>
        </div>
        <div class="flex items-center gap-4">
            <a asp-page="/Login" class="hidden md:block bg-primary text-on-primary px-6 py-2 rounded-full font-label-sm hover:opacity-80 transition-opacity active:scale-95 duration-150">Login</a>
            <button id="mobile-menu-btn" class="md:hidden text-primary">
                <span class="material-symbols-outlined">menu</span>
            </button>
        </div>
    </div>
</nav>

<!-- Hero Section -->
<section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-cover bg-center parallax-bg"
             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDbNB-TKNuA5bqCDPOuh-Wu74FOIc0mEtNkUxGPAzAjeb-TiodTxQNJhcqQMV4Srm5nCFZ1oxATlW1s-yNz2baVaZ5lKsMOkPIQmZ-JOekD9kuKjpY3_0IluWhTLZeWJZY2XJbcJDVUP7yVWWnGzkYhoSXsN--1OisX0G6nHryDndXIEA8a8CcUxibBctoCpcMSzLMumDCZiygeHld2hh98ld7WGO0TiJ1k36b98NjxlV4YQEecIlh4')">
        </div>
        <div class="absolute inset-0 bg-black/30"></div>
    </div>
    <div class="relative z-10 text-center px-container-padding-mobile max-w-4xl mx-auto">
        <div class="inline-block px-4 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/30 text-white font-label-sm mb-6">
            Transforming Waste into Crafted Living
        </div>
        <h1 class="font-display-hero-mobile md:font-display-hero text-display-hero-mobile md:text-display-hero text-white mb-6 drop-shadow-lg">
            Tôi từng là một chiếc vỏ sầu riêng
        </h1>
        <p class="font-body-lg text-body-lg text-white/90 mb-10 max-w-2xl mx-auto">
            Mỗi năm, Đồng bằng sông Cửu Long thải ra gần 1 triệu tấn vỏ sầu riêng. GAIA tái sinh phần phụ phẩm ấy thành các sản phẩm lifestyle hữu cơ — mỗi món đồ mang một mã QR kể lại hành trình của chính nó, từ vựa trái cây đến khi trở về với đất.
        </p>
        <div class="flex flex-col md:flex-row gap-4 justify-center">
            <a asp-page="/Products/Index" class="bg-primary text-on-primary px-8 py-4 rounded-full font-headline-md hover:shadow-[0_0_20px_rgba(46,125,50,0.4)] transition-all text-center">Khám phá bộ sưu tập</a>
            <a href="#traceability" class="backdrop-blur-md bg-white/10 border-2 border-white text-white px-8 py-4 rounded-full font-headline-md hover:bg-white/20 transition-all text-center">Truy xuất nguồn gốc</a>
        </div>
    </div>
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce text-white cursor-pointer">
        <span class="material-symbols-outlined text-4xl">keyboard_arrow_down</span>
    </div>
</section>

<!-- Product Story Section -->
<section id="story" class="py-section-margin px-container-padding-mobile md:px-container-padding-desktop bg-surface">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1">
            <div class="inline-block px-4 py-1 rounded-full bg-surface-accent/30 text-primary font-label-sm mb-6">CÂU CHUYỆN SẢN PHẨM</div>
            <h2 class="font-headline-lg text-headline-lg text-on-background mb-6">Vẻ đẹp từ sự tái sinh</h2>
            <div class="space-y-6">
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                    Vỏ chiếm tới 60–75% trọng lượng một quả sầu riêng, nhưng gần như toàn bộ đều bị chôn lấp hoặc đốt bỏ sau thu hoạch. Tại GAIA, chúng tôi thu gom vỏ sầu riêng từ các vựa trái cây ở Tiền Giang, Bến Tre, Vĩnh Long và Cần Thơ, rồi xử lý, khử mùi, phủ bio-resin chống ẩm và chế tác thủ công thành những vật phẩm hữu cơ cho không gian sống.
                </p>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed border-l-4 border-primary pl-6 py-2 italic bg-surface-container-low/50">
                    "Không chỉ là sản phẩm, đó là lời cam kết của chúng tôi với hành tinh xanh và sự tôn vinh đôi bàn tay khéo léo của nghệ nhân miền Tây."
                </p>
            </div>
            <div class="mt-10 flex gap-12">
                <div>
                    <div class="font-headline-md text-headline-md text-primary font-bold">60–75%</div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant">Trọng lượng quả là vỏ</div>
                </div>
                <div>
                    <div class="font-headline-md text-headline-md text-primary font-bold">100%</div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant">Vật liệu hữu cơ</div>
                </div>
                <div>
                    <div class="font-headline-md text-headline-md text-primary font-bold">QR</div>
                    <div class="font-label-sm text-label-sm text-on-surface-variant">Truy xuất mỗi sản phẩm</div>
                </div>
            </div>
        </div>
        <div class="order-1 md:order-2">
            <div class="relative group">
                <div class="absolute -inset-4 bg-primary/5 rounded-3xl -z-10 group-hover:bg-primary/10 transition-colors"></div>
                <img class="w-full rounded-2xl shadow-xl object-cover aspect-[4/5]"
                     src="~/images/uploads/story.jpg"
                     alt="GAIA Sustainable Product" />
            </div>
        </div>
    </div>
</section>

<!-- Who it's for Section -->
<section id="audience" class="py-section-margin px-container-padding-mobile md:px-container-padding-desktop bg-surface-container-lowest">
    <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-14">
            <h2 class="font-headline-lg text-headline-lg text-on-background mb-4">GAIA dành cho ai?</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Từ không gian sống cá nhân đến những thương hiệu muốn kể câu chuyện xanh của riêng mình.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="glass-card p-8 rounded-3xl custom-shadow text-center">
                <span class="material-symbols-outlined text-4xl text-primary mb-4">eco</span>
                <h3 class="font-headline-md text-headline-md text-on-background mb-2">Người trẻ sống xanh</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">Gen Z và người theo đuổi lối sống tối giản, muốn mỗi món đồ trong nhà đều có một câu chuyện đáng kể.</p>
            </div>
            <div class="glass-card p-8 rounded-3xl custom-shadow text-center">
                <span class="material-symbols-outlined text-4xl text-primary mb-4">local_cafe</span>
                <h3 class="font-headline-md text-headline-md text-on-background mb-2">Quán cà phê & không gian sáng tạo</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">Đế lót ly và chậu cây mini sỉ dài hạn, giúp xây dựng hình ảnh thương hiệu "không rác thải".</p>
            </div>
            <div class="glass-card p-8 rounded-3xl custom-shadow text-center">
                <span class="material-symbols-outlined text-4xl text-primary mb-4">cottage</span>
                <h3 class="font-headline-md text-headline-md text-on-background mb-2">Homestay & doanh nghiệp ESG</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">Trang trí bàn ăn, ban công theo phong cách mộc mạc, kèm dịch vụ khắc logo cho quà tặng doanh nghiệp.</p>
            </div>
        </div>
    </div>
</section>

<!-- Traceability & Return to Earth Section -->
<section id="traceability" class="py-section-margin bg-primary-container text-on-primary-container relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-secondary-container/20 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-on-primary-container/10 rounded-full blur-[120px]"></div>
    <div class="max-w-7xl mx-auto px-container-padding-mobile md:px-container-padding-desktop relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="font-headline-lg text-headline-lg mb-4">Từ chất thải đến sản phẩm, rồi quay lại với đất</h2>
            <p class="font-body-md text-body-md opacity-90">Mỗi sản phẩm GAIA đi kèm một mã QR — cửa sổ minh bạch cho toàn bộ vòng đời "From Waste – To Product – Back to Earth".</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
            <div class="space-y-3">
                <span class="material-symbols-outlined text-5xl mb-2 opacity-80">qr_code_scanner</span>
                <div class="font-headline-md text-headline-md">01. Quét mã QR</div>
                <p class="font-body-md text-body-md opacity-90">Xem nguồn gốc nguyên liệu, lô vỏ sầu riêng và nghệ nhân đã chế tác nên sản phẩm trong tay bạn.</p>
            </div>
            <div class="space-y-3">
                <span class="material-symbols-outlined text-5xl mb-2 opacity-80">auto_stories</span>
                <div class="font-headline-md text-headline-md">02. Khám phá hành trình</div>
                <p class="font-body-md text-body-md opacity-90">Website storytelling của GAIA kể lại quy trình xử lý, khử mùi và chế tác thủ công của từng lô sản phẩm.</p>
            </div>
            <div class="space-y-3">
                <span class="material-symbols-outlined text-5xl mb-2 opacity-80">compost</span>
                <div class="font-headline-md text-headline-md">03. Return to Earth</div>
                <p class="font-body-md text-body-md opacity-90">Khi hết vòng đời sử dụng, sản phẩm có thể ủ compost hoặc phân hủy sinh học, quay trở lại với tự nhiên.</p>
            </div>
        </div>
    </div>
</section>

<!-- Product Gallery Section -->
<section id="collection" class="py-section-margin px-container-padding-mobile md:px-container-padding-desktop">
    <div class="max-w-7xl mx-auto mb-16 flex flex-col md:flex-row justify-between items-end gap-6">
        <div class="max-w-xl">
            <h2 class="font-headline-lg text-headline-lg text-on-background mb-4">Bộ sưu tập GAIA Signature</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Khởi đầu từ những vật phẩm nhỏ gọn, tối giản — mang hơi thở của đất mẹ vào không gian sống.</p>
        </div>
        <a asp-page="/Products/Index" class="text-primary font-label-sm border-b-2 border-primary pb-1 hover:opacity-70 transition-opacity">Xem tất cả sản phẩm</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter max-w-7xl mx-auto">
        @if (Model.FeaturedProducts.Any())
        {
            <!-- Featured first product -->
            var first = Model.FeaturedProducts[1];
            <div class="lg:col-span-2 group">
                <div class="relative overflow-hidden rounded-3xl bg-surface-container-low aspect-[16/9]">
                    <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                         src="~/images/uploads/chaucay.png"
                         alt="@first.ProductName" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="absolute bottom-8 left-8 text-white translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                        <h3 class="font-headline-lg text-headline-lg">@first.ProductName</h3>
                        <p class="font-body-md text-body-md mb-4">@first.Description</p>
                        <a asp-page="/Products/Index" class="bg-white text-primary px-6 py-2 rounded-full font-label-sm">Xem ngay</a>
                    </div>
                </div>
            </div>

            @if (Model.FeaturedProducts.Count > 1)
            {
                var second = Model.FeaturedProducts[0];
                <!-- Standard product card -->
                <div class="glass-card p-6 rounded-3xl custom-shadow flex flex-col group">
                    <div class="relative overflow-hidden rounded-2xl aspect-square mb-6">
                        <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                             src="~/images/uploads/dely.png"
                             alt="@second.ProductName" />
                    </div>
                    <h3 class="font-headline-md text-headline-md text-on-background mb-2">@second.ProductName</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant mb-6">@second.Description</p>
                    <div class="mt-auto flex justify-between items-center">
                        <span class="font-label-sm text-label-sm text-primary">@second.CurrentStatus</span>
                        <a asp-page="/Products/Index" class="w-10 h-10 rounded-full border border-primary text-primary flex items-center justify-center hover:bg-primary hover:text-white transition-colors">
                            <span class="material-symbols-outlined">arrow_forward</span>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Fallback dùng đúng 2 sản phẩm cốt lõi của GAIA -->
            <div class="lg:col-span-2 group">
                <div class="relative overflow-hidden rounded-3xl bg-surface-container-low aspect-[16/9]">
                    <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                         src="~/images/uploads/dely.png"
                         alt="Đế Lót Ly Organic" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="absolute bottom-8 left-8 text-white translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300">
                        <h3 class="font-headline-lg text-headline-lg">Đế Lót Ly Organic</h3>
                        <p class="font-body-md text-body-md mb-4">Ép thủ công từ sợi vỏ sầu riêng, phủ bio-resin chống ẩm</p>
                        <a asp-page="/Products/Index" class="bg-white text-primary px-6 py-2 rounded-full font-label-sm">Mua ngay</a>
                    </div>
                </div>
            </div>
            <div class="glass-card p-6 rounded-3xl custom-shadow flex flex-col group">
                <div class="relative overflow-hidden rounded-2xl aspect-square mb-6">
                    <img class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                         src="~/images/uploads/chaucay.png"
                         alt="Chậu Cây Mini Sinh Học" />
                </div>
                <h3 class="font-headline-md text-headline-md text-on-background mb-2">Chậu Cây Mini Sinh Học</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mb-6">Nhỏ gọn cho bàn làm việc, có thể ủ compost sau khi dùng</p>
                <div class="mt-auto flex justify-between items-center">
                    <span class="font-headline-md text-headline-md text-primary">27.000đ</span>
                    <a asp-page="/Products/Index" class="w-10 h-10 rounded-full border border-primary text-primary flex items-center justify-center hover:bg-primary hover:text-white transition-colors">
                        <span class="material-symbols-outlined">add_shopping_cart</span>
                    </a>
                </div>
            </div>
        }
    </div>
    <div class="max-w-7xl mx-auto mt-8 text-center">
        <p class="font-body-md text-body-md text-on-surface-variant">Muốn tiết kiệm hơn? Thử <span class="text-primary font-medium">Combo Khởi đầu Xanh</span> — 1 chậu cây mini + 1 đế lót ly, miễn phí vận chuyển.</p>
    </div>
</section>

<!-- Artisanal Process Section -->
<section id="process" class="py-section-margin bg-surface-container-lowest">
    <div class="max-w-7xl mx-auto px-container-padding-mobile md:px-container-padding-desktop">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="font-headline-lg text-headline-lg text-on-background mb-4">Nghệ thuật của sự tỉ mỉ</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Từ vỏ sầu riêng thô đến sản phẩm hoàn thiện, mỗi lô nguyên liệu đều qua các công đoạn xử lý.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            <div class="col-span-2 row-span-2 overflow-hidden rounded-3xl h-[600px] group relative">
                <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
                     src="~/images/uploads/phase4.png"
                     alt="Chế tác thủ công" />
                <div class="absolute bottom-6 left-6 p-6 glass-card rounded-2xl max-w-[80%]">
                    <div class="font-label-sm text-primary mb-1">Giai đoạn 04: Chế tác</div>
                    <div class="font-headline-md text-headline-md">Ép khuôn thủ công</div>
                </div>
            </div>
            <div class="overflow-hidden rounded-3xl h-[290px] relative group">
                <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                     src="~/images/uploads/phase1.png"
                     alt="Thu gom vỏ sầu riêng" />
                <div class="absolute top-6 left-6 p-3 glass-card rounded-2xl max-w-[80%]">
                    <div class="font-label-sm text-primary mb-1">Giai đoạn 01:</div>
                    <div class="font-headline-md text-headline-md">Thu gom</div>
                </div>
            </div>
            <div class="overflow-hidden rounded-3xl h-[290px] relative group">
                <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                     src="~/images/uploads/phase2.png"
                     alt="Làm sạch và khử mùi" />
                <div class="absolute top-6 left-6 p-3 glass-card rounded-2xl max-w-[80%]">
                    <div class="font-label-sm text-primary mb-1">Giai đoạn 02:</div>
                    <div class="font-headline-md text-headline-md">Làm sạch & khử mùi</div>
                </div>
            </div>
            <div class="col-span-2 overflow-hidden rounded-3xl h-[285px] relative group">
                <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                     src="~/images/uploads/phase3.png"
                     alt="Phủ chống ẩm" />
                <div class="absolute top-6 left-6 p-3 glass-card rounded-2xl max-w-[80%]">
                    <div class="font-label-sm text-primary mb-1">Giai đoạn 03:</div>
                    <div class="font-headline-md text-headline-md">Phủ chống ẩm</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Impact / Mission Section -->
<section id="impact" class="py-section-margin px-container-padding-mobile md:px-container-padding-desktop bg-surface">
    <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <div class="inline-block px-4 py-1 rounded-full bg-surface-accent/30 text-primary font-label-sm mb-6">VẤN ĐỀ CHÚNG TÔI GIẢI QUYẾT</div>
            <h2 class="font-headline-lg text-headline-lg text-on-background mb-4">Một nguồn tài nguyên đang bị lãng quên</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">GAIA là dự án khởi nghiệp của sinh viên Trường Đại học FPT, Phân hiệu Cần Thơ, hiện đang ở giai đoạn phát triển nguyên mẫu (prototype). Đây là quy mô của vấn đề chúng tôi đang theo đuổi:</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center mb-16">
            <div class="glass-card p-8 rounded-3xl custom-shadow">
                <span class="material-symbols-outlined text-4xl text-primary mb-3">agriculture</span>
                <div class="font-headline-lg text-headline-lg text-primary font-bold">180.000+ ha</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant mt-1">Diện tích trồng sầu riêng tại Việt Nam</div>
            </div>
            <div class="glass-card p-8 rounded-3xl custom-shadow">
                <span class="material-symbols-outlined text-4xl text-primary mb-3">inventory_2</span>
                <div class="font-headline-lg text-headline-lg text-primary font-bold">~1,5 triệu tấn</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant mt-1">Sản lượng sầu riêng mỗi năm</div>
            </div>
            <div class="glass-card p-8 rounded-3xl custom-shadow">
